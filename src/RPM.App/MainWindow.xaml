<Window x:Class="RPM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Print Manager - In Ấn Từ Xa Doanh Nghiệp" 
        Height="630" Width="920" 
        MinHeight="630" MinWidth="920"
        MaxHeight="630" MaxWidth="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="pack://application:,,,/RPM.App;component/Assets/app.ico"
        Background="{StaticResource BgBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <ContentControl x:Name="MainContentArea" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
