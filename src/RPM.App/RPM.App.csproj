<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.NET" Version="10.0.18362.6-preview" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPM.Core\RPM.Core.csproj" />
    <ProjectReference Include="..\RPM.Printing\RPM.Printing.csproj" />
    <ProjectReference Include="..\RPM.Networking\RPM.Networking.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\BeVietnamPro-Regular.ttf" />
    <Resource Include="Assets\BeVietnamPro-SemiBold.ttf" />
    <Resource Include="Assets\BeVietnamPro-Bold.ttf" />
  </ItemGroup>

  <ItemGroup Condition="'$(EmbeddedUpdaterPath)' != '' and Exists('$(EmbeddedUpdaterPath)')">
    <EmbeddedResource Include="$(EmbeddedUpdaterPath)" LogicalName="RPM.Updater.exe" />
  </ItemGroup>

</Project>
