<Window x:Class="RPM.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RPM.App.Views"
        Title="Cài Đặt &amp; Cập Nhật Hệ Thống - Remote Print Manager" 
        Height="580" Width="820"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/RPM.App;component/Assets/app.ico"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,12" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CÀI ĐẶT &amp; CẬP NHẬT PHẦN MỀM" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                    <TextBlock Text="Cấu hình kết nối Relay, khởi chạy cùng Windows và nâng cấp phiên bản." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRoleBadge" Text="Chế độ: Máy Chủ" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Tab Content -->
        <TabControl Grid.Row="1">
            <!-- TAB 1: KẾT NỐI & HỆ THỐNG -->
            <TabItem Header="Cấu hình kết nối &amp; Hệ thống">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Card 1: Thông tin kết nối -->
                        <Border Style="{StaticResource CardBorder}" Background="#FFFFFF" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="THÔNG TIN THIẾT BỊ VÀ RELAY BROKER" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NavyMainBrush}" Margin="0,0,0,12"/>
                                
                                <TextBlock Text="Tên hiển thị của máy tính này:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtDeviceName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                                <TextBlock Text="Mã kết nối (Pairing Code):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtPairingCode" Style="{StaticResource ModernTextBox}" IsReadOnly="True" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Click="BtnRegeneratePairingCode_Click">
                                        <TextBlock Text="Sinh mã mới"/>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Địa chỉ máy chủ trung chuyển (Relay Broker WebSocket URL):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtRelayUrl" Style="{StaticResource ModernTextBox}"/>
                                <TextBlock Text="* Mặc định nội bộ: ws://127.0.0.1:9090. Khi ra Internet, nhập địa chỉ Cloud VPS của công ty." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Hành vi ứng dụng -->
                        <Border Style="{StaticResource CardBorder}" Background="#FFFFFF" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="HÀNH VI HOẠT ĐỘNG WINDOWS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NavyMainBrush}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ChkAutoStart" Content="Tự động khởi động cùng Windows khi bật máy" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkMinimizeTray" Content="Thu nhỏ xuống Khay hệ thống (System Tray) khi tắt ứng dụng" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ChkNotifications" Content="Hiện thông báo Desktop khi có máy con xin kết nối hoặc có lệnh in"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Chuyển đổi vai trò -->
                        <Border Style="{StaticResource CardBorder}" Background="#FFFFFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CHUYỂN ĐỔI VAI TRÒ ỨNG DỤNG" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NavyMainBrush}"/>
                                    <TextBlock Text="Đổi giữa Chế độ Máy Chủ (Server) và Chế độ Máy Con (Client). Hệ thống sẽ hỏi xác nhận để tránh chuyển nhầm." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnSwitchRole" Style="{StaticResource SecondaryBtn}" Click="BtnSwitchRole_Click" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSwitchRoleBtn" Text="⇄ Đổi sang Chế độ Máy Con"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: CẬP NHẬT & NÂNG CẤP -->
            <TabItem Header="Cập nhật &amp; Nâng cấp">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <views:UpdateControl x:Name="DialogUpdateControl"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}" Click="BtnSaveSettings_Click" HorizontalAlignment="Left" Width="140">
                    <TextBlock Text="Lưu cài đặt"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Click="BtnClose_Click" Width="90">
                    <TextBlock Text="Đóng"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
