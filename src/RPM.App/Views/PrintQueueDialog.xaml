<Window x:Class="RPM.App.Views.PrintQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hàng Đợi &amp; Lịch Sử Lệnh In - Remote Print Manager" 
        Height="540" Width="900"
        MinHeight="460" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/RPM.App;component/Assets/app.ico"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,12" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ĐIỀU PHỐI HÀNG ĐỢI LỆNH IN &amp; LỊCH SỬ HOẠT ĐỘNG" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                    <TextBlock x:Name="TxtQueueSummary" Text="Hàng đợi FIFO concurrent đảm bảo thứ tự in và chống in trùng lặp." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnRestartSpooler_Click" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource WarningBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Khởi động lại Spooler (Fix kẹt lệnh)"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnRefresh_Click">
                        <TextBlock Text="Làm mới"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Queue DataGrid -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="2" ClipToBounds="True">
            <DataGrid x:Name="DgQueue" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TÊN TÀI LIỆU" Binding="{Binding DocumentName}" Width="2.5*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="MÁY CON GỬI" Binding="{Binding ClientDeviceName}" Width="1.5*"/>
                    <DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding FormattedFileSize}" Width="1*"/>
                    <DataGridTextColumn Header="THỜI GIAN GỬI" Binding="{Binding SubmittedAt, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="1.6*"/>
                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                        Background="{Binding Status, Converter={StaticResource LevelToBadgeBg}}">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource LevelToBadgeFg}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="CHI TIẾT" Binding="{Binding ErrorMessage}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource DestructiveBtn}" Click="BtnClearCompleted_Click" HorizontalAlignment="Left">
                    <TextBlock Text="Xóa lịch sử hoàn tất"/>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Click="BtnClose_Click" Width="90">
                    <TextBlock Text="Đóng"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>

