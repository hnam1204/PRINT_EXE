<UserControl x:Class="RPM.App.Views.ModeSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="880">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                <Border Width="72" Height="72" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,16" Padding="6" ClipToBounds="True">
                    <Image Source="pack://application:,,,/RPM.App;component/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="REMOTE PRINT MANAGER" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="{StaticResource TextMainBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                
                <TextBlock Text="Giải pháp kết nối &amp; chia sẻ máy in qua Internet an toàn cho doanh nghiệp" 
                           FontSize="14" Foreground="{StaticResource TextMutedBrush}" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Vui lòng lựa chọn vai trò cho máy tính này trong văn phòng:" 
                       FontSize="15" FontWeight="SemiBold" 
                       Foreground="{StaticResource TextMainBrush}" 
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <!-- Cards Container -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Server Card -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Border Width="56" Height="56" Background="{StaticResource PrimaryLightBrush}" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CHẾ ĐỘ MÁY CHỦ" FontSize="18" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Máy tính cắm cáp USB vào máy in)" FontSize="12" 
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" TextWrapping="Wrap" LineHeight="22" FontSize="13" 
                                   Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,24">
                            • Tự động quét và phát hiện các máy in USB đang kết nối.<LineBreak/>
                            • Tạo mã ghép đôi kết nối không giới hạn số lượng máy con.<LineBreak/>
                            • Kiểm soát, phân quyền phòng ban và máy in của từng thiết bị.<LineBreak/>
                            • Điều phối hàng đợi in FIFO, bảo vệ chống in trùng lặp.
                        </TextBlock>

                        <Button Grid.Row="2" Style="{StaticResource PrimaryBtn}" 
                                Content="Thiết Lập Làm Máy Chủ →" 
                                Click="BtnSelectServer_Click" Height="44" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- Client Card -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Border Width="56" Height="56" Background="{StaticResource SuccessLightBrush}" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource GeoDevices}" Fill="{StaticResource SuccessBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CHẾ ĐỘ MÁY CON" FontSize="18" FontWeight="Bold" 
                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="(Máy tính văn phòng in tài liệu từ xa)" FontSize="12" 
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" TextWrapping="Wrap" LineHeight="22" FontSize="13" 
                                   Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,24">
                            • Nhập mã kết nối để liên kết an toàn tới máy chủ.<LineBreak/>
                            • Tự động tích hợp máy in ảo vào hệ thống Windows.<LineBreak/>
                            • In trực tiếp bằng <Bold>Ctrl + P</Bold> trong Word, Excel, Chrome...<LineBreak/>
                            • Mã hóa tài liệu đầu cuối (AES-256) an toàn tuyệt đối.
                        </TextBlock>

                        <Button Grid.Row="2" Style="{StaticResource SuccessBtn}" 
                                Content="Thiết Lập Làm Máy Con →" 
                                Click="BtnSelectClient_Click" Height="44" FontSize="14"/>
                    </Grid>
                </Border>
            </Grid>

            <Button Style="{StaticResource SecondaryBtn}" 
                    Content="🔍 Kiểm tra khả năng tương thích của thiết bị này (Windows 10/11 64-bit)" 
                    Click="BtnDiagnostics_Click" 
                    HorizontalAlignment="Center" Margin="0,20,0,0" Padding="18,8"/>

            <TextBlock Text="* Bạn có thể đổi lại vai trò bất cứ lúc nào trong mục Cài đặt của phần mềm." 
                       FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" 
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
