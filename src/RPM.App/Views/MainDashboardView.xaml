<UserControl x:Class="RPM.App.Views.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Khu vực A: Header -->
            <RowDefinition Height="Auto"/>
            <!-- Khu vực B & C: Main Split (Connection info & Print activities) -->
            <RowDefinition Height="*"/>
            <!-- Khu vực D: Quick Action Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- KHU VỰC A: HEADER                                         -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: NHN Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,12,0">
                        <Image Source="pack://application:,,,/RPM.App;component/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="REMOTE PRINT MANAGER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                        <TextBlock x:Name="TxtRoleSubtitle" Text="MÁY CHỦ IN ẤN (SERVER)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Connection Status & Top Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Indicator Pill -->
                    <Border x:Name="PillStatus" Background="{StaticResource SuccessLightBrush}" CornerRadius="14" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtHeaderStatus" Text="Máy chủ đang hoạt động" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings Button -->
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenSettings_Click" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource TextMainBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Cài đặt" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Minimize Button -->
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnMinimize_Click" Padding="10,6">
                        <TextBlock Text="Thu nhỏ" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- KHU VỰC B & C: NỘI DUNG CHÍNH (THÔNG TIN & HOẠT ĐỘNG IN)    -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Khu vực B: Thông tin kết nối -->
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <!-- Khu vực C: Hoạt động in ấn -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================== -->
            <!-- KHU VỰC B: THÔNG TIN MÁY CHỦ / MÁY CON                -->
            <!-- ===================================================== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoSignal}" Fill="{StaticResource PrimaryBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtCardBTitle" Text="THÔNG TIN MÁY CHỦ &amp; KẾT NỐI" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NavyMainBrush}"/>
                            </StackPanel>
                            <Border x:Name="BadgeRole" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtBadgeRole" Text="Máy Chủ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SERVER MODE CONTENT -->
                    <StackPanel Grid.Row="1" x:Name="PanelServerMode">
                        <!-- Host Name -->
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tên máy chủ:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtServerHostName" Text="MSI" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                        </Grid>

                        <!-- Pairing Code Box (Prominent UltraViewer style) -->
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MÃ KẾT NỐI (CUNG CẤP CHO MÁY CON):" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtServerPairingCode" Text="RPM-8197" FontSize="22" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryBtn}" Click="BtnCopyPairingCode_Click" Padding="12,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoCopy}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Sao chép" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Shared Printer -->
                        <TextBlock Text="MÁY IN ĐANG CHIA SẺ:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSharedPrinterName" Text="Microsoft Print to PDF" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}"/>
                                    <TextBlock x:Name="TxtSharedPrinterPort" Text="Cổng: PORTPROMPT: • Đang chia sẻ" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Click="BtnOpenPrinterDialog_Click" Padding="8,4" FontSize="11">
                                    <TextBlock Text="Đổi máy in..."/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Connection Stats -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Trạng thái máy chủ:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtServerConnectionStatus" Text="Trực tuyến (Relay Cloud: 9090)" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Số máy con kết nối:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtServerClientsSummary" Text="0 máy con (0 trực tuyến • 0 chờ duyệt)" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- CLIENT MODE CONTENT -->
                    <StackPanel Grid.Row="1" x:Name="PanelClientMode" Visibility="Collapsed">
                        <TextBlock Text="MÃ KẾT NỐI MÁY CHỦ:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtClientCodeInput" Style="{StaticResource ModernTextBox}" FontFamily="Consolas, monospace" FontSize="14" FontWeight="Bold"/>
                            <Button Grid.Column="2" x:Name="BtnClientConnectToggle" Style="{StaticResource PrimaryBtn}" Click="BtnClientConnectToggle_Click" Padding="14,8">
                                <TextBlock x:Name="TxtClientConnectBtnText" Text="Kết nối in ấn"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Máy chủ đã ghép nối:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtClientPairedServer" Text="Chưa kết nối" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Tình trạng phê duyệt:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <Border x:Name="BorderApprovalStatus" HorizontalAlignment="Right" Background="{StaticResource WarningLightBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="TxtClientApprovalStatus" Text="Chờ kết nối" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Remote Printer Card -->
                        <TextBlock Text="MÁY IN TỪ XA NHẬN ĐƯỢC:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtClientPrinterName" Text="Chưa có máy in" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}"/>
                                    <TextBlock x:Name="TxtClientPrinterStatus" Text="Cổng cục bộ: 127.0.0.1:9199" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Click="BtnClientTestPrint_Click" Padding="8,4" FontSize="11">
                                    <TextBlock Text="In thử"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================== -->
            <!-- KHU VỰC C: HOẠT ĐỘNG IN ẤN (LIVE MONITOR)              -->
            <!-- ===================================================== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="HOẠT ĐỘNG IN ẤN" FontWeight="Bold" FontSize="13" Foreground="{StaticResource NavyMainBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtQueueQuickStats" Text="0 chờ • 0 hoàn tất" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Active Printer Status Brief -->
                    <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="TxtActivePrinterSummary" Text="Máy in: Sẵn sàng nhận lệnh" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSpoolerState" Text="● Spooler OK" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Recent Jobs List -->
                    <Grid Grid.Row="2">
                        <!-- Empty State when no jobs -->
                        <StackPanel x:Name="PanelEmptyJobs" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10">
                            <Path Data="{StaticResource GeoQueue}" Fill="#CBD5E1" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Chưa có lệnh in nào đang xử lý" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Lệnh in gửi qua Ctrl + P sẽ hiển thị tại đây" FontSize="11" Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Recent Jobs ItemsControl -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IcRecentJobs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DocumentName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                                                        <Run Text="{Binding ClientDeviceName}"/>
                                                        <Run Text="•"/>
                                                        <Run Text="{Binding FormattedFileSize}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource LevelToBadgeBg}}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={StaticResource LevelToBadgeFg}}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bottom Link to Full Queue Dialog -->
                    <Button Grid.Row="3" Style="{StaticResource SecondaryBtn}" Click="BtnOpenQueueDialog_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0" Padding="8,6">
                        <TextBlock Text="📋 Mở toàn bộ hàng đợi &amp; lịch sử in..." FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- KHU VỰC D: THANH CHỨC NĂNG NHANH                          -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <!-- SERVER QUICK ACTIONS -->
                <StackPanel x:Name="ToolbarServer" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenPrinterDialog_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Quản lý máy in" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenDeviceDialog_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoDevices}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Quản lý thiết bị" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenQueueDialog_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Hàng đợi lệnh in" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenDiagnostics_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoShield}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Chẩn đoán hệ thống" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoRocket}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Cập nhật &amp; Nâng cấp" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- CLIENT QUICK ACTIONS -->
                <StackPanel x:Name="ToolbarClient" Orientation="Horizontal" Visibility="Collapsed">
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnClientInstallVirtualPrinter_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Cài đặt máy in ảo" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenQueueDialog_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Lịch sử in ấn" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenDiagnostics_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoShield}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Chẩn đoán kết nối" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnOpenSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoRocket}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Cập nhật &amp; Nâng cấp" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- FOOTER                                                    -->
        <!-- ========================================================= -->
        <Grid Grid.Row="3" Margin="4,0,4,0">
            <TextBlock Text="Remote Print Manager v1.0.1 (Beta) • Nhận diện thương hiệu NHN Blue • Mã hóa AES-256-GCM E2EE" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="UltraViewer Minimal Desktop Model" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"/>
        </Grid>
    </Grid>
</UserControl>
