<UserControl x:Class="RPM.App.Views.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RPM.App.Views"
             Background="{StaticResource BgBrush}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <!-- Khu vực A: Header (Pinned Top) -->
            <RowDefinition Height="Auto"/>
            <!-- Khu vực Nội Dung Chính: Màn hình chính HOẶC Trung tâm Cài đặt -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- KHU VỰC A: HEADER CỐ ĐỊNH                                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Logo NHN + Tên ứng dụng + Nút Quay Lại khi vào Cài Đặt -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/RPM.App;component/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="REMOTE PRINT MANAGER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                        <TextBlock x:Name="TxtRoleSubtitle" Text="MÁY CHỦ IN ẤN (SERVER)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Nút Quay lại Trang Chủ khi đang trong mục Cài Đặt -->
                    <Button x:Name="BtnHeaderBackToHome" Style="{StaticResource PrimaryBtn}" Click="BtnBackToHome_Click" Padding="10,5" Visibility="Collapsed" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoArrowLeft}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="← Quay lại Trang Chủ" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Trạng thái kết nối + Nút Cài đặt + Nút Thu nhỏ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Trạng thái kết nối -->
                    <Border x:Name="PillStatus" Background="{StaticResource SuccessLightBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotStatus" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtHeaderStatus" Text="Máy chủ đang hoạt động (Online)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút Cài đặt (Mở toàn bộ trung tâm chức năng bên trong) -->
                    <Button x:Name="BtnHeaderSettings" Style="{StaticResource SecondaryBtn}" Click="BtnOpenSettings_Click" Padding="10,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoSettings}" Fill="{StaticResource TextMainBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock Text="Cài đặt" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Thu nhỏ -->
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnMinimize_Click" Padding="9,5">
                        <TextBlock Text="Thu nhỏ" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- NỘI DUNG CHÍNH (ROW 1)                                    -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,8">

            <!-- ===================================================== -->
            <!-- 1. MÀN HÌNH CHÍNH TỐI GIẢN (ULTRAVIEWER STYLE)         -->
            <!-- (Không còn thanh toolbar rối mắt ở phía dưới)         -->
            <!-- ===================================================== -->
            <Grid x:Name="ViewHome" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <!-- Cột trái: Thông tin kết nối & Máy in chia sẻ -->
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="10"/>
                    <!-- Cột phải: Hoạt động in ấn & Spooler -->
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: THÔNG TIN KẾT NỐI -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoSignal}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtCardBTitle" Text="THÔNG TIN MÁY CHỦ &amp; KẾT NỐI" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NavyMainBrush}"/>
                                </StackPanel>
                                <Border x:Name="BadgeRole" Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtBadgeRole" Text="Máy Chủ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- SERVER MODE CONTENT -->
                        <StackPanel Grid.Row="1" x:Name="PanelServerMode">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tên máy chủ:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtServerHostName" Text="MSI" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>
                            </Grid>

                            <!-- Pairing Code Box -->
                            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MÃ KẾT NỐI (CUNG CẤP CHO MÁY CON):" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtServerPairingCode" Text="RPM-8197" FontSize="22" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnCopyPairingCode" Style="{StaticResource PrimaryBtn}" Click="BtnCopyPairingCode_Click" Padding="12,6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource GeoCopy}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="TxtCopyPairingCode" Text="Sao chép" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Shared Printer Box -->
                            <TextBlock Text="MÁY IN ĐANG CHIA SẺ:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSharedPrinterName" Text="Microsoft Print to PDF" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextMainBrush}"/>
                                        <TextBlock x:Name="TxtSharedPrinterPort" Text="Cổng: PORTPROMPT: • Đang chia sẻ 1 máy in" FontSize="10" Foreground="{StaticResource SuccessBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Click="BtnOpenPrinterDialog_Click" Padding="8,4" FontSize="10">
                                        <TextBlock Text="Đổi máy in..."/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Connection Stats -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Trạng thái máy chủ:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtServerConnectionStatus" Text="Đã kết nối Relay Broker (WSS)" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Số máy con kết nối:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtServerClientsSummary" Text="0 máy con (0 trực tuyến • 0 chờ duyệt)" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                            </Grid>
                        </StackPanel>

                        <!-- CLIENT MODE CONTENT -->
                        <StackPanel Grid.Row="1" x:Name="PanelClientMode" Visibility="Collapsed">
                            <TextBlock Text="MÃ KẾT NỐI MÁY CHỦ:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtClientCodeInput" Style="{StaticResource ModernTextBox}" FontFamily="Consolas, monospace" FontSize="13" FontWeight="Bold"/>
                                <Button Grid.Column="2" x:Name="BtnClientConnectToggle" Style="{StaticResource PrimaryBtn}" Click="BtnClientConnectToggle_Click" Padding="12,6">
                                    <TextBlock x:Name="TxtClientConnectBtnText" Text="Kết nối in ấn"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Máy chủ đã ghép nối:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtClientPairedServer" Text="Chưa kết nối" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Tình trạng phê duyệt:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border x:Name="BorderApprovalStatus" HorizontalAlignment="Right" Background="{StaticResource WarningLightBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="TxtClientApprovalStatus" Text="Chờ kết nối" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Remote Printer Card -->
                            <TextBlock Text="MÁY IN TỪ XA NHẬN ĐƯỢC:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtClientPrinterName" Text="Chưa có máy in" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextMainBrush}"/>
                                        <TextBlock x:Name="TxtClientPrinterStatus" Text="Cổng cục bộ: 127.0.0.1:9199" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Click="BtnClientTestPrint_Click" Padding="8,4" FontSize="10">
                                        <TextBlock Text="In thử"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CỘT PHẢI: HOẠT ĐỘNG IN ẤN -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="HOẠT ĐỘNG IN ẤN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NavyMainBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtQueueQuickStats" Text="0 chờ • 0 hoàn tất" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Spooler Status -->
                        <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock x:Name="TxtActivePrinterSummary" Text="Máy in chính: Microsoft Print to PDF" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSpoolerState" Text="● Spooler OK" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Recent Jobs List -->
                        <Grid Grid.Row="2">
                            <StackPanel x:Name="PanelEmptyJobs" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12">
                                <Path Data="{StaticResource GeoQueue}" Fill="#CBD5E1" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Chưa có lệnh in nào đang xử lý" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Lệnh in gửi qua Ctrl + P sẽ hiển thị tại đây" FontSize="10" Foreground="{StaticResource TextSubtleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="IcRecentJobs">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DocumentName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}">
                                                            <Run Text="{Binding ClientDeviceName}"/>
                                                            <Run Text="•"/>
                                                            <Run Text="{Binding FormattedFileSize}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                            Background="{Binding Status, Converter={StaticResource LevelToBadgeBg}}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{Binding Status, Converter={StaticResource LevelToBadgeFg}}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Bottom Link to Queue Inside Settings -->
                        <Button Grid.Row="3" Style="{StaticResource SecondaryBtn}" Click="BtnOpenQueueDialog_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0" Padding="8,5">
                            <TextBlock Text="📋 Mở toàn bộ hàng đợi &amp; lịch sử in..." FontSize="10" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- 2. TRUNG TÂM CÀI ĐẶT & QUẢN LÝ (TẤT CẢ CHỨC NĂNG Ở ĐÂY)-->
            <!-- ===================================================== -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Thanh điều hướng Tab bên trong Cài đặt -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nội dung của Tab được chọn -->
                    <RowDefinition Height="*"/>
                    <!-- Nút thao tác dưới đáy -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TAB BAR BÊN TRONG CÀI ĐẶT (SEGMENTED TABS SIÊU MƯỢT, ZERO LAG) -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnTabGeneral" Style="{StaticResource TabBtn}" Tag="Active" Click="BtnTabGeneral_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Thiết lập chung" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabPrinters" Style="{StaticResource TabBtn}" Tag="Inactive" Click="BtnTabPrinters_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPrinter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Quản lý máy in" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabDevices" Style="{StaticResource TabBtn}" Tag="Inactive" Click="BtnTabDevices_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoDevices}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Quản lý thiết bị" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabQueue" Style="{StaticResource TabBtn}" Tag="Inactive" Click="BtnTabQueue_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoQueue}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Hàng đợi lệnh in" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabDiagnostics" Style="{StaticResource TabBtn}" Tag="Inactive" Click="BtnTabDiagnostics_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoShield}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Chẩn đoán hệ thống" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabUpdate" Style="{StaticResource TabBtn}" Tag="Inactive" Click="BtnTabUpdate_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoRocket}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Cập nhật phần mềm" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- NỘI DUNG TỪNG PHÂN HỆ TRONG CÀI ĐẶT -->
                <Grid Grid.Row="1" Margin="0,0,0,8">

                    <!-- PHÂN HỆ 1: THIẾT LẬP CHUNG -->
                    <Border x:Name="TabContentGeneral" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="THIẾT LẬP HỆ THỐNG VÀ KẾT NỐI TỪ XA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tên máy tính này:" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtSettingsDeviceName" Style="{StaticResource ModernTextBox}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mã ghép đôi kết nối:" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtSettingsPairingCode" Style="{StaticResource ModernTextBox}" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                                    <Button Grid.Column="3" Style="{StaticResource SecondaryBtn}" Click="BtnSettingsRegenerateCode_Click" Padding="8,4">
                                        <TextBlock Text="Tạo mã mới" FontSize="11"/>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Máy chủ Relay Broker:" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtSettingsRelayUrl" Style="{StaticResource ModernTextBox}" FontFamily="Consolas, monospace"/>
                                </Grid>

                                <Separator Margin="0,2,0,12" Background="{StaticResource BorderLightBrush}"/>

                                <TextBlock Text="TÙY CHỌN HOẠT ĐỘNG NỀN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                <StackPanel Margin="0,0,0,12">
                                    <CheckBox x:Name="ChkSettingsAutoStart" Content="Tự động khởi động cùng Windows khi bật máy tính" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkSettingsMinimizeTray" Content="Thu nhỏ xuống khay hệ thống khi bấm nút đóng (X) để duy trì in ấn liên tục" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkSettingsNotifications" Content="Hiển thị thông báo Toast trên màn hình khi có lệnh in hoặc máy con xin ghép đôi" Margin="0,0,0,8"/>
                                </StackPanel>

                                <Separator Margin="0,2,0,12" Background="{StaticResource BorderLightBrush}"/>

                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource PrimaryBtn}" Click="BtnSaveSettings_Click" Padding="14,6" Margin="0,0,8,0">
                                            <TextBlock Text="💾 Lưu cấu hình cài đặt" FontSize="12"/>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryBtn}" Click="BtnSwitchRole_Click" Padding="12,6">
                                            <TextBlock x:Name="TxtSwitchRoleBtn" Text="⇄ Chuyển đổi vai trò Thiết bị" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- PHÂN HỆ 2: QUẢN LÝ MÁY IN -->
                    <Grid x:Name="TabContentPrinters" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header bar -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DANH SÁCH MÁY IN TRÊN HỆ THỐNG WINDOWS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                                    <TextBlock Text="Tự động nhận diện máy in cắm cáp USB, máy in mạng và máy in ảo." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryBtn}" Click="BtnPrintersRescan_Click" HorizontalAlignment="Right" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Quét lại máy in" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                            <DataGrid x:Name="DgPrinters" SelectionMode="Single" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TÊN MÁY IN" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="DRIVER WINDOWS" Binding="{Binding DriverName}" Width="2*"/>
                                    <DataGridTemplateColumn Header="CỔNG / LOẠI" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding IsUsb, Converter={StaticResource BoolToBadgeBg}}">
                                                    <TextBlock Text="{Binding PortName}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding IsUsb, Converter={StaticResource BoolToBadgeFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="CHIA SẺ" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding IsShared, Converter={StaticResource BoolToBadgeBg}}">
                                                    <TextBlock Text="{Binding IsShared, Converter={StaticResource BoolToSharingText}}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding IsShared, Converter={StaticResource BoolToBadgeFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="MẶC ĐỊNH" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IsDefault, Converter={StaticResource BoolToDefaultText}}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="● Sẵn sàng" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Action Bar -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SuccessBtn}" Click="BtnPrintersToggleShare_Click" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="✔ Bật / Tắt chia sẻ máy in đã chọn" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource PrimaryBtn}" Click="BtnPrintersSetDefault_Click" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="★ Đặt làm máy in chính" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Click="BtnPrintersTestPrint_Click" Padding="10,5">
                                    <TextBlock Text="📄 In trang kiểm tra" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PHÂN HỆ 3: QUẢN LÝ THIẾT BỊ MÁY CON -->
                    <Grid x:Name="TabContentDevices" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Filter bar -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtSearchClient" Style="{StaticResource ModernTextBox}" TextChanged="TxtSearchClient_TextChanged" ToolTip="Tìm theo tên máy, UUID hoặc phòng ban..."/>
                                    <ComboBox Grid.Column="2" x:Name="CmbStatusFilter" SelectionChanged="CmbFilter_SelectionChanged" Height="32" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Tất cả trạng thái"/>
                                        <ComboBoxItem Content="Trực tuyến (Online)"/>
                                        <ComboBoxItem Content="Chờ phê duyệt"/>
                                        <ComboBoxItem Content="Ngoại tuyến (Offline)"/>
                                    </ComboBox>
                                    <ComboBox Grid.Column="4" x:Name="CmbDepartmentFilter" SelectionChanged="CmbFilter_SelectionChanged" Height="32" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="6" Style="{StaticResource SecondaryBtn}" Click="BtnClearFilters_Click" Padding="8,4">
                                        <TextBlock Text="Xóa lọc" FontSize="11"/>
                                    </Button>
                                </Grid>
                                <TextBlock Grid.Row="1" x:Name="TxtClientStats" Text="Tổng: 0 thiết bị | Online: 0 | Chờ duyệt: 0 | Offline: 0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                            <DataGrid x:Name="DgClients" SelectionMode="Single" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TÊN MÁY CON" Binding="{Binding DeviceName}" Width="1.8*" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="MÃ THIẾT BỊ (UUID)" Binding="{Binding DeviceId}" Width="2*"/>
                                    <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding Department}" Width="1.3*"/>
                                    <DataGridTextColumn Header="MÁY IN ĐƯỢC PHÉP" Binding="{Binding AllowedPrintersSummary}" Width="1.5*"/>
                                    <DataGridTextColumn Header="ĐÃ IN" Binding="{Binding PrintCount}" Width="0.8*"/>
                                    <DataGridTemplateColumn Header="TRỰC TUYẾN" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding IsOnline, Converter={StaticResource OnlineBadgeBg}}">
                                                    <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToOnlineText}}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding IsOnline, Converter={StaticResource OnlineBadgeFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PHÊ DUYỆT" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding IsApproved, Converter={StaticResource BoolToBadgeBg}}">
                                                    <TextBlock Text="{Binding IsApproved, Converter={StaticResource BoolToApprovedText}}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding IsApproved, Converter={StaticResource BoolToBadgeFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Action Bar -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SuccessBtn}" Click="BtnApproveClient_Click" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="✔ Phê duyệt" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Click="BtnChangeDepartment_Click" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="🏢 Đổi phòng ban" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource SecondaryBtn}" Click="BtnAssignPrinters_Click" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="🖨️ Phân quyền máy in" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource DangerBtn}" Click="BtnRevokeClient_Click" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="🚫 Thu hồi" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource DestructiveBtn}" Click="BtnDeleteClient_Click" Padding="10,5">
                                    <TextBlock Text="🗑️ Xóa" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PHÂN HỆ 4: HÀNG ĐỢI LỆNH IN -->
                    <Grid x:Name="TabContentQueue" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header bar -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="HÀNG ĐỢI LỆNH IN &amp; LỊCH SỬ ĐIỀU PHỐI (FIFO)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                                    <TextBlock x:Name="TxtQueueSummary" Text="Tổng số: 0 lệnh in • Đang chờ/xử lý: 0 • Hoàn tất: 0 • Lỗi: 0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryBtn}" Click="BtnQueueRefresh_Click" HorizontalAlignment="Right" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Làm mới danh sách" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                            <DataGrid x:Name="DgQueue" SelectionMode="Single" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TÊN TÀI LIỆU" Binding="{Binding DocumentName}" Width="2.2*" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="MÁY CON GỬI" Binding="{Binding ClientDeviceName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="MÁY IN ĐÍCH" Binding="{Binding TargetPrinter}" Width="1.8*"/>
                                    <DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding FormattedFileSize}" Width="1.1*"/>
                                    <DataGridTextColumn Header="THỜI GIAN GỬI" Binding="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss - dd/MM}}" Width="1.3*"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding Status, Converter={StaticResource LevelToBadgeBg}}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={StaticResource LevelToBadgeFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Action Bar -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryBtn}" Click="BtnRestartSpooler_Click" Padding="10,5" Margin="0,0,6,0">
                                    <TextBlock Text="🔄 Khởi động lại Spooler Windows" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource DestructiveBtn}" Click="BtnClearCompletedJobs_Click" Padding="10,5">
                                    <TextBlock Text="Xóa lịch sử hoàn tất" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PHÂN HỆ 5: CHẨN ĐOÁN HỆ THỐNG -->
                    <Grid x:Name="TabContentDiagnostics" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Summary Banner -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="CHẨN ĐOÁN HỆ THỐNG &amp; KIỂM TOÁN HOẠT ĐỘNG THỰC TẾ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                                    <TextBlock x:Name="TxtDiagSpecs" Text="Máy tính: MSI • Windows 11 Build 26300 (64-bit)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource SuccessLightBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="TxtDiagScore" Text="82.0% HOẠT ĐỘNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="8,4">
                                        <TextBlock x:Name="TxtDiagSummary" Text="19 PASS • 5 BLOCKED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                            <DataGrid x:Name="DgAuditItems" SelectionMode="Single" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="HẠNG MỤC KIỂM TRA" Binding="{Binding TestName}" Width="2*" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="TRỌNG SỐ" Binding="{Binding WeightPercent, StringFormat={}{0}%}" Width="0.7*"/>
                                    <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding Status, Converter={StaticResource AuditStatusToBadgeBg}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource AuditStatusToText}}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Status, Converter={StaticResource AuditStatusToBadgeFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="NGUỒN DỮ LIỆU" Width="1.2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                        Background="{Binding DataSource, Converter={StaticResource DataSourceToBadgeBg}}">
                                                    <TextBlock Text="{Binding DataSource, Converter={StaticResource DataSourceToText}}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding DataSource, Converter={StaticResource DataSourceToBadgeFg}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="BẰNG CHỨNG XÁC MINH THỰC TẾ" Binding="{Binding VerificationDetail}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Action Bar -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <Button Style="{StaticResource PrimaryBtn}" Click="BtnRerunDiagnostics_Click" HorizontalAlignment="Left" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GeoShield}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Chạy lại kiểm toán toàn bộ" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>

                    <!-- PHÂN HỆ 6: CẬP NHẬT PHẦN MỀM -->
                    <Border x:Name="TabContentUpdate" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <views:UpdateControl x:Name="SettingsUpdateControl"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- NÚT QUAY LẠI TRANG CHỦ DƯỚI ĐÁY CÀI ĐẶT -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <Grid>
                        <TextBlock Text="Mọi chức năng quản lý đều được điều khiển tập trung tại đây." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource PrimaryBtn}" Click="BtnBackToHome_Click" HorizontalAlignment="Right" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoArrowLeft}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Hoàn tất &amp; Quay lại Trang Chủ" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- FOOTER                                                    -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2" Margin="2,0,2,0">
            <TextBlock Text="Remote Print Manager v1.0.1 • Nhận diện thương hiệu NHN Blue • Mã hóa AES-256-GCM E2EE" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="UltraViewer Minimal Desktop Model • 100% Single-Window UI" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextSubtleBrush}"/>
        </Grid>
    </Grid>
</UserControl>
