<UserControl x:Class="RPM.App.Views.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RPM.App.Views"
             Background="{StaticResource BgBrush}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <!-- Khu vực A: Header (Pinned Top) -->
            <RowDefinition Height="Auto"/>
            <!-- Khu vực Nội Dung Chính: Màn hình chính HOẶC Trung tâm Cài đặt -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- KHU VỰC A: HEADER CỐ ĐỊNH                                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Logo NHN + Tên ứng dụng -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/RPM.App;component/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="REMOTE PRINT MANAGER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                        <TextBlock x:Name="TxtRoleSubtitle" Text="MÁY CHỦ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                </StackPanel>

                <!-- Right: Trạng thái kết nối + Nút Cài đặt -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Trạng thái kết nối -->
                    <Border x:Name="PillStatus" Background="{StaticResource WarningLightBrush}" CornerRadius="12" Padding="9,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotStatus" Width="7" Height="7" Fill="{StaticResource WarningBrush}" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtHeaderStatus" Text="Chưa kết nối" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút chuyển giữa trang chính và cài đặt -->
                    <Button x:Name="BtnHeaderSettings" Style="{StaticResource SecondaryBtn}" Click="BtnOpenSettings_Click" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="BtnHeaderSettingsIcon" Data="{StaticResource GeoSettings}" Fill="{StaticResource TextMainBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                            <TextBlock x:Name="BtnHeaderSettingsText" Text="Cài đặt" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- NỘI DUNG CHÍNH (ROW 1)                                    -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,8">

            <!-- ===================================================== -->
            <!-- 1. MÀN HÌNH CHÍNH TỐI GIẢN (ULTRAVIEWER STYLE)         -->
            <!-- (Không còn thanh toolbar rối mắt ở phía dưới)         -->
            <!-- ===================================================== -->
            <Grid x:Name="ViewHome" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ViewSettingsContentRow" Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Cột trái: Thông tin kết nối & Máy in chia sẻ -->
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="10"/>
                    <!-- Cột phải: Hoạt động in ấn & Spooler -->
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: THÔNG TIN KẾT NỐI -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- SERVER MODE CONTENT -->
                        <StackPanel Grid.Row="0" x:Name="PanelServerMode">
                            <!-- Pairing Code Box -->
                            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MÃ KẾT NỐI" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtServerPairingCode" Text="RPM-8197" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtServerPairingExpiry" Text="Mã kết nối nội bộ" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnRegeneratePairingCode" Style="{StaticResource SecondaryBtn}" Click="BtnRegeneratePairingCode_Click" Padding="10,6" Margin="0,0,6,0">
                                            <TextBlock Text="Tạo mã mới" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="BtnCopyPairingCode" Style="{StaticResource PrimaryBtn}" Click="BtnCopyPairingCode_Click" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoCopy}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="TxtCopyPairingCode" Text="Sao chép mã" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Shared Printer Box -->
                            <TextBlock Text="MÁY IN CHIA SẺ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSharedPrinterName" Text="Microsoft Print to PDF" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextMainBrush}"/>
                                        <TextBlock x:Name="TxtSharedPrinterPort" Text="Cổng: PORTPROMPT:" FontSize="10" Foreground="{StaticResource SuccessBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Click="BtnOpenPrinterDialog_Click" Padding="8,4" FontSize="10">
                                        <TextBlock Text="Đổi máy in"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Connection Stats -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Kết nối:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtServerConnectionStatus" Text="Chưa kết nối" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Máy con:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtServerClientsSummary" Text="0 máy con" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Giới hạn khoảng cách:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtServerGeofenceStatus" Text="Đang tắt" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Địa chỉ LAN:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtServerLanEndpoint" Text="Đang tìm..." HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" MaxWidth="250" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- CLIENT MODE CONTENT -->
                        <StackPanel Grid.Row="0" x:Name="PanelClientMode" Visibility="Collapsed">
                            <TextBlock Text="ĐỊA CHỈ MÁY CHỦ LAN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtClientRelayAddress" Style="{StaticResource ModernTextBox}" FontSize="12" Margin="0,0,0,4" ToolTip="Ví dụ: ws://192.168.1.20:9090"/>
                            <TextBlock Text="Nhập địa chỉ ws:// hiển thị trên máy chủ khi dùng chung mạng LAN." FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="MÃ KẾT NỐI" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtClientCodeInput" Style="{StaticResource ModernTextBox}" FontSize="13" FontWeight="Bold"/>
                                <Button Grid.Column="2" x:Name="BtnClientConnectToggle" Style="{StaticResource PrimaryBtn}" Click="BtnClientConnectToggle_Click" Padding="12,6">
                                    <TextBlock x:Name="TxtClientConnectBtnText" Text="Kết nối"/>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Máy chủ:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtClientPairedServer" Text="Chưa kết nối" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Trạng thái quyền:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border x:Name="BorderApprovalStatus" HorizontalAlignment="Right" Background="{StaticResource WarningLightBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="TxtClientApprovalStatus" Text="Chưa kết nối" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Giới hạn khoảng cách:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtClientGeofenceStatus" Text="Chưa xác minh" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            </Grid>

                            <!-- Remote Printer Card -->
                            <TextBlock Text="MÁY IN TỪ XA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtClientPrinterName" Text="Chưa có máy in" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextMainBrush}"/>
                                        <TextBlock x:Name="TxtClientPrinterStatus" Text="Sẵn sàng nhận tài liệu" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="BtnClientSetupPrinter" Style="{StaticResource SecondaryBtn}" Click="BtnClientSetupPrinter_Click" Padding="8,4" FontSize="10" Margin="0,0,4,0">
                                            <TextBlock Text="Thiết lập Ctrl + P"/>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryBtn}" Click="BtnClientTestPrint_Click" Padding="8,4" FontSize="10">
                                            <TextBlock Text="In thử"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CỘT PHẢI: HOẠT ĐỘNG IN ẤN -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="LỆNH IN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource NavyMainBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtQueueQuickStats" Text="0 chờ • 0 hoàn tất" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnQueueRefresh_Click" Width="26" Height="24" Padding="0" ToolTip="Làm mới lệnh in" AutomationProperties.Name="Làm mới lệnh in">
                                        <Path Data="{StaticResource GeoRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Spooler Status -->
                        <Border Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock x:Name="TxtActivePrinterSummary" Text="Máy in chính: Microsoft Print to PDF" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSpoolerState" Text="Sẵn sàng" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Recent Jobs List -->
                        <Grid Grid.Row="2">
                            <StackPanel x:Name="PanelEmptyJobs" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,12">
                                <Path Data="{StaticResource GeoQueue}" Fill="#CBD5E1" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Không có lệnh in nào" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="IcRecentJobs">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="{StaticResource GeoQueue}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DocumentName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}">
                                                            <Run Text="{Binding ClientDeviceName}"/>
                                                            <Run Text="•"/>
                                                            <Run Text="{Binding FormattedFileSize}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                            Background="{Binding Status, Converter={StaticResource LevelToBadgeBg}}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{Binding Status, Converter={StaticResource LevelToBadgeFg}}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Bottom Link to Queue Inside Settings -->
                        <Button Grid.Row="3" Style="{StaticResource SecondaryBtn}" Click="BtnOpenQueueDialog_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0" Padding="8,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoQueue}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Xem tất cả lệnh in" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- 2. TRUNG TÂM CÀI ĐẶT & QUẢN LÝ (TẤT CẢ CHỨC NĂNG Ở ĐÂY)-->
            <!-- ===================================================== -->
            <Grid x:Name="ViewSettings" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Thanh điều hướng Tab bên trong Cài đặt -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nội dung của Tab được chọn -->
                    <RowDefinition Height="*"/>
                    <!-- Nút thao tác dưới đáy -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TAB BAR BÊN TRONG CÀI ĐẶT (SEGMENTED TABS SIÊU MƯỢT, ZERO LAG) -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnTabGeneral" Style="{StaticResource TabBtn}" Tag="Active" Click="BtnTabGeneral_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Chung" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabPrinters" Style="{StaticResource TabBtn}" Tag="Inactive" Click="BtnTabPrinters_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoPrinter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Máy in" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnTabDevices" Style="{StaticResource TabBtn}" Tag="Inactive" Click="BtnTabDevices_Click" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoDevices}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Thiết bị" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- NỘI DUNG TỪNG PHÂN HỆ TRONG CÀI ĐẶT -->
                <Grid Grid.Row="1" Margin="0,0,0,8">

                    <!-- PHÂN HỆ 1: THIẾT LẬP CHUNG -->
                    <Border x:Name="TabContentGeneral" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Visible" VerticalAlignment="Top">
                        <ScrollViewer VerticalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="CÀI ĐẶT CHUNG" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tên máy:" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtSettingsDeviceName" Style="{StaticResource ModernTextBox}" IsReadOnly="True"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vai trò:" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtSettingsRole" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trạng thái:" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtSettingsConnectionStatus" Text="Chưa kết nối nội bộ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Windows:" FontSize="12" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtSettingsWindowsVersion" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Kết nối dịch vụ" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                            <TextBlock x:Name="TxtCloudStatus" Text="Đang tắt" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Grid Grid.Row="0" Grid.Column="1">
                                            <StackPanel>
                                                <Grid>
                                                    <PasswordBox x:Name="TxtCloudEnrollmentSecret" Height="28" Padding="7,4" VerticalContentAlignment="Center" ToolTip="Mã kích hoạt do quản trị viên cấp"/>
                                                    <TextBlock x:Name="TxtCloudEnrollmentMaskedKey" Visibility="Collapsed" VerticalAlignment="Center" Padding="7,0" FontSize="11" Foreground="{StaticResource TextMainBrush}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="TxtCloudLicenseSummary" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="7,3,8,0" FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnCloudEnroll" Style="{StaticResource SecondaryBtn}" Click="BtnCloudEnroll_Click" Padding="10,5" Margin="8,0,0,0" MinWidth="88">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <ProgressBar x:Name="PbCloudEnroll" Width="14" Height="14" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtCloudEnrollButton" Text="Kích hoạt" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnChangeCloudEnrollment" Style="{StaticResource SecondaryBtn}" Click="BtnChangeCloudEnrollment_Click" Padding="10,5" Margin="8,0,0,0" Visibility="Collapsed">
                                                <TextBlock Text="Đổi mã kích hoạt" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Visibility="Collapsed">
                                    <CheckBox x:Name="ChkSettingsMinimizeTray" Content="Ẩn xuống khay khi bấm nút đóng" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkSettingsNotifications" Content="Hiện thông báo khi có lệnh in hoặc yêu cầu kết nối" Margin="0,0,0,8"/>
                                </StackPanel>

                                <Separator Margin="0,2,0,10" Background="{StaticResource BorderLightBrush}"/>

                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource PrimaryBtn}" Click="BtnSaveSettings_Click" Padding="14,6" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoSave}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Lưu" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryBtn}" Click="BtnSwitchRole_Click" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoSwap}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="TxtSwitchRoleBtn" Text="Đổi vai trò" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Cập nhật phần mềm" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                            <TextBlock x:Name="TxtSettingsUpdateStatus" Text="Chưa kiểm tra cập nhật" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="TxtSettingsUpdateVersion" Text="V1.0.1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,12,0"/>
                                    <Button x:Name="BtnSettingsUpdateAction" Grid.Column="2" Style="{StaticResource SecondaryBtn}" Click="BtnSettingsCheckUpdate_Click" Height="34" VerticalAlignment="Center" Padding="10,5">
                                        <TextBlock x:Name="TxtSettingsUpdateAction" Text="Kiểm tra cập nhật" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Background="#EAF8F5" BorderBrush="#B7E5DB" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Bộ phận hỗ trợ Zalo" FontSize="12" FontWeight="SemiBold" Foreground="#075E54"/>
                                            <TextBlock Text="0379052767 · Hỗ trợ cài đặt và kết nối" FontSize="11" Foreground="#287C70" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Click="BtnOpenZaloSupport_Click" Height="34" Padding="12,5" VerticalAlignment="Center">
                                            <TextBlock Text="Mở Zalo" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <views:UpdateControl x:Name="SettingsUpdateControl" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- PHÂN HỆ 2: MÁY IN + LỆNH IN -->
                    <Grid x:Name="TabContentPrinters" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="MÁY IN" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                                    <TextBlock x:Name="TxtPrintersConnectionStatus" Text="Chọn máy in để xem thông tin và lệnh in." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryBtn}" Click="BtnPrintersRescan_Click" HorizontalAlignment="Right" Padding="10,5">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/><TextBlock Text="Làm mới danh sách" FontSize="11" FontWeight="SemiBold"/></StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbPrinterSelection" Grid.Column="0" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectionChanged="CmbPrinterSelection_SelectionChanged" ToolTip="Chọn máy in"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedPrinterInfo" Text="Chưa chọn máy in" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
                                    <TextBlock x:Name="TxtSelectedPrinterStatus" Text="Chọn một máy in trong danh sách" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <ToggleButton x:Name="TglPrinterSharing" Style="{StaticResource PrinterToggle}" Click="BtnPrinterToggleSelected_Click" ToolTip="Bật hoặc tắt chia sẻ máy in" AutomationProperties.Name="Bật hoặc tắt máy in"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="12,8"><Grid><StackPanel><TextBlock Text="LỆNH IN" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/><TextBlock x:Name="TxtQueueSummary" Text="Tổng số: 0 lệnh in" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/></StackPanel><Button Style="{StaticResource SecondaryBtn}" Click="BtnQueueRefresh_Click" HorizontalAlignment="Right" Width="26" Height="24" Padding="0" ToolTip="Làm mới lệnh in" AutomationProperties.Name="Làm mới lệnh in"><Path Data="{StaticResource GeoRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform"/></Button></Grid></Border>
                                <DataGrid x:Name="DgQueue" Grid.Row="1" SelectionMode="Single" AutoGenerateColumns="False">
                                     <DataGrid.Columns><DataGridTextColumn Header="TÊN TÀI LIỆU" Binding="{Binding DocumentName}" Width="2.2*" FontWeight="Bold"/><DataGridTextColumn Header="THIẾT BỊ GỬI" Binding="{Binding ClientDeviceName}" Width="1.5*"/><DataGridTextColumn Header="MÁY IN" Binding="{Binding TargetPrinter}" Width="1.8*"/><DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding FormattedFileSize}" Width="1.1*"/><DataGridTextColumn Header="THỜI GIAN" Binding="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss - dd/MM}}" Width="1.3*"/><DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="{Binding Status, Converter={StaticResource LevelToBadgeBg}}"><TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding Status, Converter={StaticResource LevelToBadgeFg}}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryBtn}" Click="BtnPrintersTestPrint_Click" Padding="10,5" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource GeoDocument}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/><TextBlock Text="In trang kiểm tra" FontSize="11"/></StackPanel></Button><Button Style="{StaticResource SecondaryBtn}" Click="BtnRestartSpooler_Click" Padding="10,5" Margin="0,0,6,0"><TextBlock Text="Khởi động lại dịch vụ in" FontSize="11"/></Button><Button Style="{StaticResource DestructiveBtn}" Click="BtnClearCompletedJobs_Click" Padding="10,5"><TextBlock Text="Xóa lệnh in đã hoàn tất" FontSize="11"/></Button></StackPanel>
                        </Border>
                    </Grid>

                    <!-- PHÂN HỆ 3: QUẢN LÝ THIẾT BỊ MÁY CON -->
                    <Grid x:Name="TabContentDevices" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="MÁY CON" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                                <TextBlock x:Name="TxtClientStats" Text="0 máy con · 0 máy đang trực tuyến · 0 yêu cầu đang chờ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Filter bar -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CmbStatusFilter" Style="{StaticResource ModernComboBox}" Height="34" VerticalAlignment="Center" SelectionChanged="CmbFilter_SelectionChanged" ToolTip="Lọc thiết bị theo trạng thái">
                                        <ComboBoxItem Content="Tất cả"/>
                                        <ComboBoxItem Content="Máy đang trực tuyến"/>
                                        <ComboBoxItem Content="Máy đang ngoại tuyến"/>
                                        <ComboBoxItem Content="Chờ duyệt"/>
                                        <ComboBoxItem Content="Đã được chấp nhận"/>
                                        <ComboBoxItem Content="Đã từ chối"/>
                                        <ComboBoxItem Content="Đã thu hồi quyền"/>
                                    </ComboBox>
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="TxtSearchClient" Style="{StaticResource ModernTextBox}" Height="34" Padding="30,0,10,0" VerticalContentAlignment="Center" TextChanged="TxtSearchClient_TextChanged" ToolTip="Tìm theo tên máy con"/>
                                        <Path Data="M9 2a7 7 0 1 0 4.9 12L19 19.1 17.1 21l-5.9-5.9A7 7 0 0 0 9 2zm0 2a5 5 0 1 1 0 10A5 5 0 0 1 9 4z" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                    </Grid>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnRefreshDevices" Style="{StaticResource SecondaryBtn}" Click="BtnRefreshDevices_Click" Height="34" Padding="12,5" Margin="0,0,6,0" ToolTip="Đồng bộ yêu cầu kết nối mới nhất">
                                            <TextBlock Text="Làm mới" FontSize="11"/>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryBtn}" Click="BtnClearFilters_Click" Height="34" Padding="12,5" ToolTip="Xóa tìm kiếm và bộ lọc">
                                            <TextBlock Text="Xóa lọc" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Compact device list -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" ClipToBounds="True">
                            <Grid>
                                <ListBox x:Name="DgClients" BorderThickness="0" Background="Transparent" SelectionMode="Single">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="{Binding DeviceName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/><TextBlock Text="{Binding LastSeen, StringFormat={}{0:dd/MM HH:mm}}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/></StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource BgBrush}" CornerRadius="5" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding PermissionStatus}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/></Border>
                                                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding AllowedPrintersSummary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,12,0"/>
                                                <Button Grid.Column="3" Style="{StaticResource SecondaryBtn}" Click="BtnManageClient_Click" Padding="11,5" VerticalAlignment="Center"><TextBlock Text="Quản lý" FontSize="11"/></Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="PanelClientsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="Chưa có thiết bị kết nối" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Mở ứng dụng trên máy con, nhập mã kết nối và gửi yêu cầu kết nối." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                </Grid>

                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <Grid>
                        <TextBlock Text="Quản lý máy in và kết nối tại đây." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- FOOTER                                                    -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2" Margin="2,0,2,0">
            <TextBlock Text="2026 © hnam1204. All rights reserved" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Kết nối an toàn" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextSubtleBrush}"/>
        </Grid>
    </Grid>
</UserControl>
