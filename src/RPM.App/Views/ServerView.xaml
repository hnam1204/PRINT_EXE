<UserControl x:Class="RPM.App.Views.ServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RPM.App.Views"
             xmlns:converters="clr-namespace:RPM.App.Converters"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="70"/>
            <!-- Content Area with Tabs -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top App Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Margin="0,0,14,0">
                        <Path Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="REMOTE PRINT MANAGER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="MÁY CHỦ IN ẤN (SERVER)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Badge -->
                    <Border x:Name="ServerStatusIndicator" Background="{StaticResource SuccessLightBrush}" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="20" Padding="14,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtServerStatus" Text="Máy chủ đang hoạt động" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryBtn}" Content="Thu nhỏ" Click="BtnMinimize_Click" Padding="14,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Margin="24,20,24,20" Background="Transparent" BorderThickness="0">
            <!-- 1. TỔNG QUAN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tổng Quan" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Top Stat Cards -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Shared Printer -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MÁY IN ĐANG CHIA SẺ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtOverviewPrinterName" Text="Chưa chọn máy in" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,8,0,6" TextTrimming="CharacterEllipsis"/>
                                        <Border x:Name="BadgePrinterStatus" Background="{StaticResource PrimaryLightBrush}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TxtOverviewPrinterStatus" Text="Đang chia sẻ trực tuyến" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" Background="{StaticResource PrimaryLightBrush}" CornerRadius="22" VerticalAlignment="Top">
                                        <Path Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 2: Connected Clients -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MÁY CON TRỰC TUYẾN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtOverviewClientsCount" Text="0 / 3 Thiết bị" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,4"/>
                                        <TextBlock x:Name="TxtOverviewPendingClients" Text="0 máy con đang chờ phê duyệt" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" Background="{StaticResource SuccessLightBrush}" CornerRadius="22" VerticalAlignment="Top">
                                        <Path Data="{StaticResource GeoDevices}" Fill="{StaticResource SuccessBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Card 3: Print Jobs Today -->
                            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LỆNH IN HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtOverviewJobsCount" Text="0 Hoàn tất" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,4"/>
                                        <TextBlock x:Name="TxtOverviewQueueStatus" Text="Hàng đợi: 0 đang chờ xử lý" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="44" Height="44" Background="{StaticResource WarningLightBrush}" CornerRadius="22" VerticalAlignment="Top">
                                        <Path Data="{StaticResource GeoQueue}" Fill="{StaticResource WarningBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Pairing Code Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Path Data="{StaticResource GeoShield}" Fill="{StaticResource PrimaryBrush}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="THÔNG TIN GHÉP ĐÔI (DÀNH CHO 3 MÁY CON)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="Cung cấp mã này cho các máy con trong bán kính 1km để gửi yêu cầu kết nối in ấn an toàn:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                    
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="20,8" Margin="0,0,12,0">
                                            <TextBlock x:Name="TxtPairingCode" Text="RPM-8821" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                        <Button Style="{StaticResource SecondaryBtn}" Click="BtnCopyPairingCode_Click" Height="44" Padding="16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GeoCopy}" Fill="{StaticResource TextMainBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sao chép mã" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Cloud Status Indicator -->
                                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Trạng thái Relay Cloud:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtRelayStatus" Text="Đã kết nối ổn định (WSS)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Recent Activity Log -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoSignal}" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG THỜI GIAN THỰC" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryBtn}" Content="Xóa nhật ký" Click="BtnClearLog_Click" HorizontalAlignment="Right" Padding="12,5" FontSize="11"/>
                                </Grid>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                    <ListBox x:Name="LstActivityLog" Height="220" BorderThickness="0" Background="Transparent" FontFamily="Consolas, Segoe UI" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. MÁY IN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoPrinter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Máy In" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Button Style="{StaticResource PrimaryBtn}" Click="BtnRescanPrinters_Click" HorizontalAlignment="Left" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource GeoRefresh}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Quét lại máy in trên máy tính" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Chọn máy in kết nối qua dây USB để chia sẻ cho 3 máy con." HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </Grid>

                    <!-- Modern DataGrid with Badges -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="DgPrinters" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÊN MÁY IN" Binding="{Binding Name}" Width="2*"/>
                                
                                <!-- Mặc định Badge -->
                                <DataGridTemplateColumn Header="MẶC ĐỊNH" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding IsDefault, Converter={StaticResource BoolToBadgeBg}}" 
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding IsDefault, Converter={StaticResource BoolToDefaultText}}" 
                                                           Foreground="{Binding IsDefault, Converter={StaticResource BoolToBadgeFg}}" 
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Đang chia sẻ Badge -->
                                <DataGridTemplateColumn Header="CHIA SẺ" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding IsShared, Converter={StaticResource BoolToBadgeBg}}" 
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding IsShared, Converter={StaticResource BoolToSharingText}}" 
                                                           Foreground="{Binding IsShared, Converter={StaticResource BoolToBadgeFg}}" 
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Màu -->
                                <DataGridTemplateColumn Header="MÀU" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SupportsColor, Converter={StaticResource BoolToColorText}}" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Duplex -->
                                <DataGridTemplateColumn Header="IN 2 MẶT" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SupportsDuplex, Converter={StaticResource BoolToDuplexText}}" 
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status Badge -->
                                <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SuccessLightBrush}" CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="● Sẵn sàng" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Bottom Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SuccessBtn}" Content="✔ Chọn làm máy in chia sẻ" Click="BtnSetSharedPrinter_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SecondaryBtn}" Content="📄 In trang kiểm tra (Test Print)" Click="BtnTestPrint_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource DangerBtn}" Content="Tạm dừng chia sẻ" Click="BtnPauseSharing_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 3. THIẾT BỊ KẾT NỐI -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoDevices}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thiết Bị Kết Nối" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh sách máy con gửi yêu cầu kết nối sử dụng máy in trong bán kính 1km:" Margin="0,0,0,14" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>

                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="DgClients" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÊN MÁY CON" Binding="{Binding DeviceName}" Width="1.5*"/>
                                <DataGridTextColumn Header="MÃ THIẾT BỊ (UUID)" Binding="{Binding DeviceId}" Width="2*"/>
                                <DataGridTextColumn Header="HỆ ĐIỀU HÀNH" Binding="{Binding OperatingSystem}" Width="1.5*"/>
                                
                                <DataGridTemplateColumn Header="TRỰC TUYẾN" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding IsOnline, Converter={StaticResource OnlineBadgeBg}}" 
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToOnlineText}}" 
                                                           Foreground="{Binding IsOnline, Converter={StaticResource OnlineBadgeFg}}" 
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="PHÊ DUYỆT" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding IsApproved, Converter={StaticResource BoolToBadgeBg}}" 
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding IsApproved, Converter={StaticResource BoolToApprovedText}}" 
                                                           Foreground="{Binding IsApproved, Converter={StaticResource BoolToBadgeFg}}" 
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SuccessBtn}" Content="✔ Phê duyệt (Approve)" Click="BtnApproveClient_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource DangerBtn}" Content="🚫 Thu hồi quyền (Revoke)" Click="BtnRevokeClient_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 4. HÀNG ĐỢI IN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoQueue}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hàng Đợi In" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Các tài liệu gửi từ máy con được điều phối in lần lượt (FIFO) kèm cơ chế chống in trùng lặp:" Margin="0,0,0,14" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>

                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="DgQueue" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÊN TÀI LIỆU" Binding="{Binding DocumentName}" Width="2*"/>
                                <DataGridTextColumn Header="MÁY CON GỬI" Binding="{Binding SenderDeviceName}" Width="1.5*"/>
                                <DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding FileSizeBytes}" Width="100"/>
                                <DataGridTextColumn Header="THỜI GIAN GỬI" Binding="{Binding SubmittedAt, StringFormat='HH:mm:ss dd/MM'}" Width="130"/>
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="CHI TIẾT" Binding="{Binding StatusMessage}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryBtn}" Content="Làm mới danh sách" Click="BtnRefreshQueue_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource DangerBtn}" Content="Xóa lịch sử hoàn tất" Click="BtnClearHistory_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 5. CÀI ĐẶT -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cài Đặt" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                        <!-- Update & Upgrade Section -->
                        <views:UpdateControl x:Name="ServerUpdateControl" Margin="0,0,0,18"/>

                        <!-- Server Configuration Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Cấu Hình Máy Chủ" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                                <TextBlock Text="Tên hiển thị của máy chủ:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtServerName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                                <TextBlock Text="Mã kết nối (Pairing Code):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtSettingPairingCode" Style="{StaticResource ModernTextBox}"/>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Content="Sinh mã mới" Click="BtnRegenerateCode_Click" Height="40"/>
                                </Grid>

                                <TextBlock Text="Địa chỉ Relay Broker (WebSocket URL):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtRelayUrl" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                                <CheckBox x:Name="ChkAutoStart" Content="Tự động khởi động cùng Windows" FontSize="13" Margin="0,0,0,12" IsChecked="True"/>
                                <CheckBox x:Name="ChkMinimizeTray" Content="Thu nhỏ xuống Khay hệ thống (System Tray) khi tắt ứng dụng" FontSize="13" Margin="0,0,0,12" IsChecked="True"/>
                                <CheckBox x:Name="ChkNotifications" Content="Hiện thông báo Desktop khi có máy con xin kết nối hoặc có lệnh in" FontSize="13" Margin="0,0,0,24" IsChecked="True"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryBtn}" Content="Lưu Cài Đặt" Click="BtnSaveSettings_Click" Margin="0,0,14,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Content="🔄 Đổi sang Chế Độ Máy Con" Click="BtnSwitchToClient_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
