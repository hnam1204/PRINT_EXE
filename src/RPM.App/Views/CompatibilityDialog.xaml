<Window x:Class="RPM.App.Views.CompatibilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đánh Giá Mức Độ Hoạt Động Thực Tế &amp; Chẩn Đoán Hệ Thống - Remote Print Manager"
        Height="760" Width="1060"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/RPM.App;component/Assets/app.ico"
        Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Tabs -->
            <RowDefinition Height="*"/>
            <!-- Bottom Action Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="48" Height="48" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,14,0" Padding="4">
                <Image Source="pack://application:,,,/RPM.App;component/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ĐÁNH GIÁ MỨC ĐỘ HOẠT ĐỘNG THỰC TẾ &amp; CHẨN ĐOÁN HỆ THỐNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                <TextBlock Text="Kiểm tra kết nối máy thật, cổng USB máy in, phân loại REAL/MOCK DATA và đo lường tỷ lệ hoạt động thực tế" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHostSpecs" Text="MSI • Windows 11 (64-bit)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}"/>
            </Border>
        </Grid>

        <!-- Tab Control: Audit vs Diagnostics -->
        <TabControl Grid.Row="1" Margin="0,0,0,16">
            <!-- TAB 1: ĐO LƯỜNG HOẠT ĐỘNG THỰC TẾ (AUDIT) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊 Bảng Đánh Giá Mức Độ Hoạt Động Thực Tế (7 Nhóm = 100%)" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top 4 Summary Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Verified Score -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="TỶ LỆ HOẠT ĐỘNG XÁC MINH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="TxtScorePercent" Text="77.0%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text=" / 100%" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,4"/>
                                </StackPanel>
                                <TextBlock Text="Đạt bằng chứng trên máy thật" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Test Progress -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="TIẾN ĐỘ KIỂM THỬ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="TxtExecutionRate" Text="100%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    <TextBlock Text=" (27/27 bài)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,4"/>
                                </StackPanel>
                                <TextBlock Text="Đã hoàn thành toàn bộ bài test" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Pass / Blocked -->
                        <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="KẾT QUẢ KIỂM TRA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtPassFailSummary" Text="22 PASS • 5 BLOCKED" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,6,0,0"/>
                                <TextBlock Text="0 bài FAIL • 0 lỗi nghiêm trọng" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Data Source Distribution -->
                        <Border Grid.Column="6" Style="{StaticResource CardBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="PHÂN LOẠI NGUỒN DỮ LIỆU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="TxtDataSourceSummary" Text="100% REAL / CACHED" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Text="0% MOCK DATA (Không giả lập)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Main Audit DataGrid -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="DgAuditItems" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NHÓM CHỨC NĂNG" Binding="{Binding GroupName}" Width="190"/>
                                <DataGridTextColumn Header="BÀI KIỂM TRA" Binding="{Binding Name}" Width="190"/>
                                <DataGridTextColumn Header="TRỌNG SỐ" Binding="{Binding WeightPercent, StringFormat='{}{0}%'}" Width="80"/>

                                <!-- Status Badge -->
                                <DataGridTemplateColumn Header="KẾT QUẢ" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource AuditStatusToBadgeBg}}" 
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource AuditStatusToText}}" 
                                                           Foreground="{Binding Status, Converter={StaticResource AuditStatusToBadgeFg}}" 
                                                           FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Data Source Badge -->
                                <DataGridTemplateColumn Header="NGUỒN DỮ LIỆU" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding DataSource, Converter={StaticResource DataSourceToBadgeBg}}" 
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding DataSource, Converter={StaticResource DataSourceToText}}" 
                                                           Foreground="{Binding DataSource, Converter={StaticResource DataSourceToBadgeFg}}" 
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="BẰNG CHỨNG THỰC TẾ &amp; GHI CHÚ" Binding="{Binding Evidence}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Limitations Notice -->
                    <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="⚠️ CÁC GIỚI HẠN HIỆN TẠI ĐỂ ĐẠT 100% HOÀN TẤT RA GIẤY THẬT:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="• Máy tính kiểm thử chưa cắm cáp USB vào máy in vật lý (Canon/HP...) và chưa nạp giấy in thật." FontSize="11" Foreground="{StaticResource TextMainBrush}"/>
                            <TextBlock Text="• Môi trường đơn lẻ chưa kết nối đồng thời 3 máy con vật lý độc lập qua mạng Internet bên ngoài." FontSize="11" Foreground="{StaticResource TextMainBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: CHẨN ĐOÁN HỆ THỐNG & DRIVER -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛠️ Chẩn Đoán Phần Cứng &amp; Dịch Vụ Spooler" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Overall Status Banner -->
                    <Border Grid.Row="0" x:Name="BannerOverall" Background="{StaticResource SuccessLightBrush}" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtOverallTitle" Text="● HỆ THỐNG HOÀN TOÀN TƯƠNG THÍCH" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock x:Name="TxtOverallMessage" Text="Thiết bị đáp ứng đầy đủ điều kiện để cài đặt và vận hành Remote Print Manager." FontSize="12" Foreground="{StaticResource TextMainBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtDeviceSpec" Text="Win 11 x64" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Diagnostics DataGrid -->
                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="DgDiagnostics" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="HẠNG MỤC" Binding="{Binding Category}" Width="130"/>
                                <DataGridTextColumn Header="THÀNH PHẦN KIỂM TRA" Binding="{Binding Name}" Width="190"/>
                                <DataGridTextColumn Header="THÔNG TIN HỆ THỐNG" Binding="{Binding Detail}" Width="1.8*"/>

                                <!-- Badge Status -->
                                <DataGridTemplateColumn Header="KẾT QUẢ" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Level, Converter={StaticResource LevelToBadgeBg}}" 
                                                    CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" Margin="4,0">
                                                <TextBlock Text="{Binding Level, Converter={StaticResource LevelToText}}" 
                                                           Foreground="{Binding Level, Converter={StaticResource LevelToBadgeFg}}" 
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="KHUYẾN NGHỊ / HƯỚNG DẪN" Binding="{Binding Recommendation}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2">
            <Button Style="{StaticResource SecondaryBtn}" Content="🔄 Chạy lại kiểm tra thực tế" Click="BtnRescan_Click" HorizontalAlignment="Left" Padding="16,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource WarningBtn}" Content="🛠️ Khởi động lại Spooler" Click="BtnRestartSpooler_Click" Margin="0,0,10,0" Padding="14,8"/>
                <Button Style="{StaticResource PrimaryBtn}" Content="Đóng" Click="BtnClose_Click" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
