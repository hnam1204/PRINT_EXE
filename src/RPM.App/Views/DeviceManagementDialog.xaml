<Window x:Class="RPM.App.Views.DeviceManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Thiết Bị Máy Con - Remote Print Manager" 
        Height="540" Width="920"
        MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/RPM.App;component/Assets/app.ico"
        Background="{StaticResource BgBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,12" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="QUẢN LÝ THIẾT BỊ MÁY CON (MỞ RỘNG KHÔNG GIỚI HẠN)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                    <TextBlock x:Name="TxtClientStats" Text="Tổng: 0 thiết bị | Online: 0 | Chờ duyệt: 0 | Offline: 0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Click="BtnRefresh_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoRefresh}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Làm mới"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="10" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtSearchClient" Style="{StaticResource ModernTextBox}" Margin="0,0,10,0"
                         TextChanged="TxtSearchClient_TextChanged" Tag="Tìm kiếm theo tên máy con hoặc phòng ban..."/>
                <ComboBox Grid.Column="1" x:Name="CmbStatusFilter" Margin="0,0,10,0" SelectionChanged="CmbFilter_SelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                    <ComboBoxItem Content="Trực tuyến (Online)"/>
                    <ComboBoxItem Content="Ngoại tuyến (Offline)"/>
                    <ComboBoxItem Content="Chờ phê duyệt"/>
                </ComboBox>
                <ComboBox Grid.Column="2" x:Name="CmbDepartmentFilter" Margin="0,0,10,0" SelectionChanged="CmbFilter_SelectionChanged"/>
                <Button Grid.Column="3" Style="{StaticResource SecondaryBtn}" Click="BtnClearFilters_Click" Content="Xóa bộ lọc"/>
            </Grid>
        </Border>

        <!-- Device List DataGrid -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="2" ClipToBounds="True">
            <DataGrid x:Name="DgClients" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TÊN MÁY CON" Binding="{Binding DeviceName}" Width="1.8*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="MÃ THIẾT BỊ (UUID)" Binding="{Binding DeviceId}" Width="2*"/>
                    <DataGridTextColumn Header="PHÒNG BAN" Binding="{Binding Department}" Width="1.3*"/>
                    <DataGridTextColumn Header="MÁY IN ĐƯỢC PHÉP" Binding="{Binding AllowedPrintersSummary}" Width="2*"/>
                    <DataGridTextColumn Header="ĐÃ IN" Binding="{Binding TotalJobsPrinted}" Width="0.8*"/>
                    <DataGridTemplateColumn Header="TRỰC TUYẾN" Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                        Background="{Binding IsOnline, Converter={StaticResource OnlineBadgeBg}}">
                                    <TextBlock Text="{Binding IsOnline, Converter={StaticResource BoolToOnlineText}}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding IsOnline, Converter={StaticResource OnlineBadgeFg}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="PHÊ DUYỆT" Width="1.1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                        Background="{Binding IsApproved, Converter={StaticResource BoolToBadgeBg}}">
                                    <TextBlock Text="{Binding IsApproved, Converter={StaticResource BoolToApprovedText}}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding IsApproved, Converter={StaticResource BoolToBadgeFg}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action Bar -->
        <Border Grid.Row="3" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource SuccessBtn}" Click="BtnApproveClient_Click" Margin="0,0,8,0">
                        <TextBlock Text="✔ Phê duyệt kết nối"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnChangeDepartment_Click" Margin="0,0,8,0">
                        <TextBlock Text="Đổi phòng ban"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryBtn}" Click="BtnAssignPrinters_Click" Margin="0,0,8,0">
                        <TextBlock Text="Phân quyền máy in"/>
                    </Button>
                    <Button Style="{StaticResource DestructiveBtn}" Click="BtnRevokeClient_Click" Margin="0,0,8,0">
                        <TextBlock Text="Thu hồi quyền / Chặn"/>
                    </Button>
                    <Button Style="{StaticResource DestructiveBtn}" Click="BtnDeleteClient_Click">
                        <TextBlock Text="Xóa thiết bị"/>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Click="BtnClose_Click" Width="90">
                    <TextBlock Text="Đóng"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
