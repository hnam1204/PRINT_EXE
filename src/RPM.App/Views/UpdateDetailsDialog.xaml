<Window x:Class="RPM.App.Views.UpdateDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập nhật phần mềm" Width="720" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Cập nhật phần mềm" FontSize="18" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <views:UpdateControl x:Name="UpdateDetailsControl" xmlns:views="clr-namespace:RPM.App.Views"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Đóng" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right" Click="BtnClose_Click" Padding="16,7" Margin="0,12,0,0"/>
    </Grid>
</Window>
