<UserControl x:Class="RPM.App.Views.UpdateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <StackPanel Margin="0,5,0,0">
        <!-- Main Update Card -->
        <Border Style="{StaticResource CardBorder}" Background="#FFFFFF" Margin="0,0,0,15">
            <StackPanel Margin="6">
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource GeoRefresh}" Fill="{StaticResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CẬP NHẬT" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Cập nhật phần mềm và giữ nguyên dữ liệu." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Status Pill -->
                    <Border Grid.Column="2" x:Name="BorderStatusBadge" Background="{StaticResource PrimaryLightBrush}" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotUpdateStatus" Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtStatusBadge" Text="Sẵn sàng kiểm tra" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Version Info Grid: 4 Cards -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Version -->
                    <Border Grid.Column="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ĐANG DÙNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtCurrentVersion" Text="V1.0.0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Release Channel -->
                    <Border Grid.Column="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="KÊNH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtCurrentChannel" Text="Bản chính thức" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Latest Version -->
                    <Border Grid.Column="4" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="BẢN MỚI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtLatestVersion" Text="Chưa kiểm tra" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Release Date -->
                    <Border Grid.Column="6" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="NGÀY RA MẮT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtReleaseDate" Text="--" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="BtnCheckUpdate" Style="{StaticResource SecondaryBtn}" Click="BtnCheckUpdate_Click" Margin="0,0,10,0" Height="40" Padding="16,8">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource GeoSignal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Kiểm tra"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnUpdateNow" Style="{StaticResource PrimaryBtn}" Click="BtnUpdateNow_Click" Margin="0,0,10,0" Height="40" Padding="20,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource GeoRocket}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Cập nhật ngay"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnRollback" Style="{StaticResource SecondaryBtn}" Click="BtnRollback_Click" Margin="0,0,10,0" Height="40" Padding="14,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource GeoRestart}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Khôi phục bản cũ"/></StackPanel>
                    </Button>
                    <Button x:Name="BtnToggleChangelog" Style="{StaticResource SecondaryBtn}" Click="BtnToggleChangelog_Click" Margin="0,0,10,0" Height="40" Padding="14,8" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource GeoDocument}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/><TextBlock Text="Xem thay đổi"/></StackPanel>
                    </Button>
                </StackPanel>

                <!-- Progress Bar Area -->
                <StackPanel x:Name="PanelProgress" Visibility="Collapsed" Margin="0,0,0,14">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtProgressStatus" Text="Đang tải..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock x:Name="TxtProgressPercentage" Text="0%" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>
                    <ProgressBar x:Name="PbDownload" Height="10" Maximum="100" Value="0" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>

                <!-- Changelog Box -->
                <Border x:Name="BorderChangelog" Visibility="Collapsed" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="THAY ĐỔI TRONG BẢN MỚI:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="IcChangelog">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="• " FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMainBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Settings Controls Row -->
                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Auto Check & Auto Install -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <CheckBox x:Name="ChkAutoCheck" Content="Tự kiểm tra bản mới mỗi giờ" 
                                      FontSize="12" Margin="0,0,0,8" IsChecked="True" 
                                      Checked="ChkAutoCheck_Changed" Unchecked="ChkAutoCheck_Changed"/>
                            
                            <CheckBox x:Name="ChkAutoInstall" Content="Tự cập nhật sau khi in xong" 
                                      FontSize="12" Margin="0,0,0,0" IsChecked="False" 
                                      Checked="ChkAutoInstall_Changed" Unchecked="ChkAutoInstall_Changed"/>
                        </StackPanel>

                        <!-- Release Channel ComboBox -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Kênh cập nhật máy tính này:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbChannel" Width="210" Height="30" SelectionChanged="CmbChannel_SelectionChanged">
                                <ComboBoxItem Content="Bản chính thức" Tag="Stable"/>
                                <ComboBoxItem Content="Bản thử nghiệm" Tag="Beta"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Footer -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="* Cập nhật không xóa cài đặt và máy in." 
                               FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Style="{StaticResource SecondaryBtn}" Click="BtnViewHistory_Click" Padding="12,5" FontSize="11">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource GeoQueue}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/><TextBlock Text="Lịch sử"/></StackPanel>
                    </Button>
                </Grid>

                <!-- Update Feed URL Config -->
                <Expander Header="Cấu hình nâng cao địa chỉ máy chủ cập nhật (Feed URL)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtFeedUrl" Style="{StaticResource ModernTextBox}" FontSize="11"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryBtn}" Content="Lưu địa chỉ" Click="BtnSaveFeedUrl_Click" Padding="10,4" FontSize="11"/>
                        </Grid>
                        <TextBlock Text="* Địa chỉ này dùng để tìm bản cập nhật." FontSize="10" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Expander>

                <!-- Update History List -->
                <Expander x:Name="ExpHistory" Header="Lịch sử các lần nâng cấp thành công trên máy này" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0">
                    <DataGrid x:Name="DgUpdateHistory" AutoGenerateColumns="False" IsReadOnly="True" 
                              Height="140" Background="White" BorderBrush="{StaticResource BorderBrush}" 
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Từ Phiên Bản" Binding="{Binding FromVersion}" Width="100"/>
                            <DataGridTextColumn Header="Lên Phiên Bản" Binding="{Binding ToVersion}" Width="110"/>
                            <DataGridTextColumn Header="Kênh" Binding="{Binding Channel}" Width="90"/>
                            <DataGridTextColumn Header="Thời Gian Nâng Cấp" Binding="{Binding InstalledAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
