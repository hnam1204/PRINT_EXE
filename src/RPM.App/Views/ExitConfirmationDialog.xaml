<Window x:Class="RPM.App.Views.ExitConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận thoát"
        Width="490" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#FFFFFF" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="10" 
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.15" Color="#001947"/>
        </Border.Effect>
        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border Width="30" Height="30" Background="{StaticResource WarningLightBrush}" CornerRadius="15" Margin="0,0,10,0">
                    <Path Data="{StaticResource GeoShield}" Fill="{StaticResource WarningBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="THOÁT ỨNG DỤNG?" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyMainBrush}"/>
                    <TextBlock Text="Ứng dụng in qua mạng" FontSize="10" Foreground="{StaticResource TextSubtleBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Content Question -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="Bạn muốn thoát ứng dụng?" 
                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="Chọn Ẩn để ứng dụng vẫn chạy và máy khác vẫn in được." 
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource SecondaryBtn}" Click="BtnCancel_Click" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GeoCancel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                        <TextBlock Text="Hủy" FontSize="11" FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryBtn}" Click="BtnMinimize_Click" Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoDevices}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Ẩn xuống khay" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DestructiveBtn}" Click="BtnExit_Click" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource GeoPower}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Thoát" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
