<UserControl x:Class="RPM.App.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RPM.App.Views"
             xmlns:converters="clr-namespace:RPM.App.Converters"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="70"/>
            <!-- Content Area with Tabs -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Top App Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" Padding="3">
                        <Image Source="/Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="REMOTE PRINT MANAGER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="MÁY CON IN TỪ XA (CLIENT)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ClientStatusIndicator" Background="{StaticResource PrimaryLightBrush}" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="20" Padding="14,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotClientStatus" Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtClientStatus" Text="Đang kết nối máy chủ..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryBtn}" Content="🔍 Chẩn đoán" Click="BtnOpenDiagnostics_Click" Margin="0,0,10,0" Padding="12,6"/>
                    <Button Style="{StaticResource SecondaryBtn}" Content="Thu nhỏ" Click="BtnMinimize_Click" Padding="14,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Margin="24,20,24,20" Background="Transparent" BorderThickness="0">
            <!-- 1. TỔNG QUAN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoDashboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tổng Quan" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Top Highlights Banner -->
                        <Border Style="{StaticResource CardBorder}" Background="#EFF6FF" BorderBrush="#BFDBFE" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" Background="#DBEAFE" CornerRadius="19" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Path Data="{StaticResource GeoPrinter}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="IN TRỰC TIẾP TỪ BẤT KỲ ỨNG DỤNG NÀO VỚI PHÍM CTRL + P" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Bạn chỉ cần mở Word, Excel, Chrome, Acrobat Reader... sau đó nhấn Ctrl + P, chọn máy in của công ty và bấm In. Lệnh in sẽ tự động truyền qua Internet đến máy in qua kết nối bảo mật!" 
                                               FontSize="12" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cards Row -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Remote Printer Info -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="MÁY IN CÔNG TY ĐÃ KẾT NỐI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtClientPrinterName" Text="Chưa kết nối máy chủ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,8,0,6"/>
                                    <TextBlock x:Name="TxtClientPrinterStatus" Text="Trạng thái: Vui lòng kết nối ghép đôi" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock x:Name="TxtClientSpoolerStatus" Text="Máy in ảo Windows: Đang kiểm tra..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Quick Stats -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="LỆNH IN ĐÃ GỬI TỪ MÁY NÀY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtClientJobsCount" Text="0 Tài liệu" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="TxtClientLastPrintTime" Text="Chưa có lệnh in nào hôm nay" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Button Style="{StaticResource SuccessBtn}" Content="📄 In trang kiểm tra thử nghiệm" Click="BtnTestPrint_Click" Margin="0,12,0,0" Height="38"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent Print Activity -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Path Data="{StaticResource GeoSignal}" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG THỜI GIAN THỰC" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                                    <ListBox x:Name="LstClientLog" Height="200" BorderThickness="0" Background="Transparent" FontFamily="Consolas, Segoe UI" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. KẾT NỐI MÁY CHỦ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoSignal}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tìm &amp; Kết Nối Máy Chủ" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <Border Style="{StaticResource CardBorder}" MaxWidth="680" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Ghép Đôi Với Máy Chủ In Ấn" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Nhập Mã Ghép Đôi (Pairing Code) do Máy Chủ cung cấp:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtInputPairingCode" Style="{StaticResource ModernTextBox}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Địa chỉ Máy Chủ Relay Cloud (Mặc định hoặc riêng của công ty):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtClientRelayUrl" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                            <Button Style="{StaticResource PrimaryBtn}" Content="🚀 Gửi Yêu Cầu Ghép Đôi Tới Máy Chủ" Click="BtnConnectServer_Click" Height="44" FontSize="14" Margin="0,0,0,20"/>

                            <!-- Approval Notice Card -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="TÌNH TRẠNG PHÊ DUYỆT TỪ MÁY CHỦ:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtApprovalStatus" Text="Chưa gửi yêu cầu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- 3. MÁY IN CỦA TÔI -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoPrinter}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Máy In Của Tôi" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Thiết Lập Máy In Ảo Windows (Chuẩn IPP)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Để in tài liệu bằng phím Ctrl + P trong Word hoặc Excel, máy con cần đăng ký máy in ảo vào hệ thống Windows. Thao tác này hoàn toàn tự động chỉ với 1 click:" 
                                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="BtnInstallPrinter" Style="{StaticResource SuccessBtn}" Content="⚙️ Cài Đặt Máy In Ảo Vào Windows" Click="BtnInstallVirtualPrinter_Click" Height="42" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource DangerBtn}" Content="Gỡ bỏ máy in ảo" Click="BtnRemoveVirtualPrinter_Click" Height="42" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Content="In thử nghiệm" Click="BtnTestPrint_Click" Height="42"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtVirtualInstallResult" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Thông Tin Máy In Vật Lý Tại Máy Chủ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtRemotePrinterDetails" Text="Chưa có thông tin máy in" FontSize="13" Foreground="{StaticResource TextMutedBrush}" LineHeight="22"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. LỊCH SỬ IN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoQueue}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lịch Sử In" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh sách các tài liệu bạn đã in qua máy chủ:" Margin="0,0,0,14" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>

                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid x:Name="DgClientHistory" IsReadOnly="True" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="TÊN TÀI LIỆU" Binding="{Binding DocumentName}" Width="2*"/>
                                <DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding FileSizeBytes}" Width="100"/>
                                <DataGridTextColumn Header="THỜI GIAN GỬI" Binding="{Binding SubmittedAt, StringFormat='HH:mm:ss dd/MM'}" Width="130"/>
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="CHI TIẾT XỬ LÝ" Binding="{Binding StatusMessage}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource DangerBtn}" Content="Xóa danh sách lịch sử" Click="BtnClearClientHistory_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 5. CÀI ĐẶT -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource GeoSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cài Đặt" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                        <!-- Update & Upgrade Section -->
                        <views:UpdateControl x:Name="ClientUpdateControl" Margin="0,0,0,18"/>

                        <!-- Client Configuration Card -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Cấu Hình Máy Con" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,16"/>

                                <TextBlock Text="Tên nhận diện máy tính này (VD: KeToan-PC, KinhDoanh-01):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtClientDeviceName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                                <TextBlock Text="Cổng Máy In Ảo Cục Bộ (Local IPP Port):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtClientIppPort" Style="{StaticResource ModernTextBox}" Text="9199" Margin="0,0,0,20"/>

                                <CheckBox x:Name="ChkClientAutoStart" Content="Tự động khởi động cùng Windows" FontSize="13" Margin="0,0,0,12" IsChecked="True"/>
                                <CheckBox x:Name="ChkClientMinimizeTray" Content="Thu nhỏ xuống khay hệ thống khi tắt ứng dụng" FontSize="13" Margin="0,0,0,12" IsChecked="True"/>
                                <CheckBox x:Name="ChkClientNotifications" Content="Hiện thông báo bong bóng khi lệnh in hoàn tất" FontSize="13" Margin="0,0,0,24" IsChecked="True"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SuccessBtn}" Content="Lưu Cài Đặt" Click="BtnSaveClientSettings_Click" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Content="🔍 Chẩn Đoán Thiết Bị" Click="BtnOpenDiagnostics_Click" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Content="🔄 Đổi sang Chế Độ Máy Chủ" Click="BtnSwitchToServer_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Remote Print Manager v1.0.0 - Kết nối in ấn độc lập qua Internet" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Path Data="{StaticResource GeoShield}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Mã hóa AES-256-GCM E2EE" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
