<UserControl x:Class="RPM.App.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RPM.App.Views"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="64"/>
            <!-- Content Area with Tabs -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Top App Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💻" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="REMOTE PRINT MANAGER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="MÁY CON IN TỪ XA (CLIENT)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ClientStatusIndicator" Background="#F0F6FF" CornerRadius="12" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotClientStatus" Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtClientStatus" Text="Đang kết nối máy chủ..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryBtn}" Content="Thu nhỏ" Click="BtnMinimize_Click" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
            <!-- 1. TỔNG QUAN -->
            <TabItem Header="📊 Tổng Quan" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                    <StackPanel>
                        <!-- Top Highlights Banner -->
                        <Border Style="{StaticResource CardBorder}" Background="#F0F8FF" BorderBrush="#BEE3F8" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💡" FontSize="36" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="IN TRỰC TIẾP TỪ BẤT KỲ ỨNG DỤNG NÀO VỚI PHÍM CTRL + P" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Bạn chỉ cần mở Word, Excel, Chrome, Acrobat Reader... sau đó nhấn Ctrl + P, chọn máy in của công ty và nhấn In. Lệnh in sẽ tự động truyền đến máy in qua mạng Internet độc lập!" 
                                               FontSize="12" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cards Row -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Remote Printer Info -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="MÁY IN CÔNG TY ĐÃ KẾT NỐI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtClientPrinterName" Text="Chưa kết nối máy chủ" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,8,0,4"/>
                                    <TextBlock x:Name="TxtClientPrinterStatus" Text="Trạng thái: Vui lòng kết nối ghép đôi" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtClientSpoolerStatus" Text="Máy in ảo Windows: Đang kiểm tra..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick Stats -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="LỆNH IN ĐÃ GỬI TỪ MÁY NÀY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtClientJobsCount" Text="0 Tài liệu" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="TxtClientLastPrintTime" Text="Chưa có lệnh in nào hôm nay" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Button Style="{StaticResource SuccessBtn}" Content="📄 In trang kiểm tra thử nghiệm" Click="BtnTestPrint_Click" Margin="0,10,0,0" Height="36"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Recent Print Activity -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                                <ListBox x:Name="LstClientLog" Height="200" BorderThickness="0" Background="#FAFAFA" FontFamily="Consolas, Segoe UI" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. KẾT NỐI MÁY CHỦ -->
            <TabItem Header="🔗 Tìm &amp; Kết Nối Máy Chủ" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                    <Border Style="{StaticResource CardBorder}" MaxWidth="650" HorizontalAlignment="Left">
                        <StackPanel Margin="10">
                            <TextBlock Text="Ghép Đôi Với Máy Chủ In Ấn" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Nhập Mã Ghép Đôi (Pairing Code) do Máy Chủ cung cấp:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtInputPairingCode" Style="{StaticResource ModernTextBox}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Địa chỉ Máy Chủ Relay Cloud (Mặc định hoặc riêng của cty):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtClientRelayUrl" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                            <Button Style="{StaticResource PrimaryBtn}" Content="🚀 Gửi Yêu Cầu Ghép Đôi Tới Máy Chủ" Click="BtnConnectServer_Click" Height="42" FontSize="14" Margin="0,0,0,20"/>

                            <!-- Approval Notice Card -->
                            <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="TÌNH TRẠNG PHÊ DUYỆT TỪ MÁY CHỦ:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtApprovalStatus" Text="Chưa gửi yêu cầu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- 3. MÁY IN CỦA TÔI -->
            <TabItem Header="🖨️ Máy In Của Tôi" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock Text="Thiết Lập Máy In Ảo Windows (Chuẩn IPP)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Để in tài liệu bằng phím Ctrl + P trong Word hoặc Excel, máy con cần đăng ký máy in ảo vào hệ thống Windows. Thao tác này hoàn toàn tự động chỉ với 1 click:" 
                                           FontSize="13" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="BtnInstallPrinter" Style="{StaticResource SuccessBtn}" Content="⚙️ Cài Đặt Máy In Ảo Vào Windows" Click="BtnInstallVirtualPrinter_Click" Height="40" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource DangerBtn}" Content="Gỡ bỏ máy in ảo" Click="BtnRemoveVirtualPrinter_Click" Height="40" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Content="In thử nghiệm" Click="BtnTestPrint_Click" Height="40"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtVirtualInstallResult" Text="" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Thông Tin Máy In Vật Lý Tại Máy Chủ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtRemotePrinterDetails" Text="Chưa có thông tin máy in" FontSize="13" Foreground="{StaticResource TextMutedBrush}" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. LỊCH SỬ IN -->
            <TabItem Header="📑 Lịch Sử In" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh sách các tài liệu bạn đã in qua máy chủ:" Margin="0,0,0,12" FontSize="13" Foreground="{StaticResource TextMainBrush}"/>

                    <DataGrid Grid.Row="1" x:Name="DgClientHistory" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên Tài Liệu" Binding="{Binding DocumentName}" Width="2*"/>
                            <DataGridTextColumn Header="Kích Thước" Binding="{Binding FileSizeBytes}" Width="100"/>
                            <DataGridTextColumn Header="Thời Gian Gửi" Binding="{Binding SubmittedAt, StringFormat='HH:mm:ss dd/MM'}" Width="130"/>
                            <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Chi Tiết Xử Lý" Binding="{Binding StatusMessage}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Style="{StaticResource DangerBtn}" Content="Xóa danh sách lịch sử" Click="BtnClearClientHistory_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 5. CÀI ĐẶT -->
            <TabItem Header="⚙️ Cài Đặt" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <!-- Update & Upgrade Section -->
                        <views:UpdateControl x:Name="ClientUpdateControl" Margin="0,0,0,15"/>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                            <StackPanel Margin="10">
                                <TextBlock Text="Cấu Hình Máy Con" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,16"/>

                                <TextBlock Text="Tên nhận diện máy tính này (VD: KeToan-PC, KinhDoanh-01):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtClientDeviceName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                                <TextBlock Text="Cổng Máy In Ảo Cục Bộ (Local IPP Port):" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtClientIppPort" Style="{StaticResource ModernTextBox}" Text="9199" Margin="0,0,0,20"/>

                                <CheckBox x:Name="ChkClientAutoStart" Content="Tự động khởi động cùng Windows" FontSize="13" Margin="0,0,0,10" IsChecked="True"/>
                                <CheckBox x:Name="ChkClientMinimizeTray" Content="Thu nhỏ xuống khay hệ thống khi tắt ứng dụng" FontSize="13" Margin="0,0,0,10" IsChecked="True"/>
                                <CheckBox x:Name="ChkClientNotifications" Content="Hiện thông báo bong bóng khi lệnh in hoàn tất" FontSize="13" Margin="0,0,0,24" IsChecked="True"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SuccessBtn}" Content="Lưu Cài Đặt" Click="BtnSaveClientSettings_Click" Margin="0,0,15,0"/>
                                    <Button Style="{StaticResource SecondaryBtn}" Content="🔄 Đổi sang Chế Độ Máy Chủ" Click="BtnSwitchToServer_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#EFEFF0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Remote Print Manager v1.0.0 - Kết nối in ấn độc lập qua Internet" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="Mã hóa AES-256-GCM E2EE" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
