<Application x:Class="RPM.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RPM.App"
             xmlns:converters="clr-namespace:RPM.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:BoolToSharingTextConverter x:Key="BoolToSharingText"/>
            <converters:BoolToColorTextConverter x:Key="BoolToColorText"/>
            <converters:BoolToDuplexTextConverter x:Key="BoolToDuplexText"/>
            <converters:BoolToDefaultTextConverter x:Key="BoolToDefaultText"/>
            <converters:BoolToApprovedTextConverter x:Key="BoolToApprovedText"/>
            <converters:BoolToOnlineTextConverter x:Key="BoolToOnlineText"/>
            <converters:BoolToBadgeBgConverter x:Key="BoolToBadgeBg"/>
            <converters:BoolToBadgeFgConverter x:Key="BoolToBadgeFg"/>
            <converters:OnlineBadgeBgConverter x:Key="OnlineBadgeBg"/>
            <converters:OnlineBadgeFgConverter x:Key="OnlineBadgeFg"/>
            <converters:LevelToBadgeBgConverter x:Key="LevelToBadgeBg"/>
            <converters:LevelToBadgeFgConverter x:Key="LevelToBadgeFg"/>
            <converters:LevelToTextConverter x:Key="LevelToText"/>
            <converters:AuditStatusToBadgeBgConverter x:Key="AuditStatusToBadgeBg"/>
            <converters:AuditStatusToBadgeFgConverter x:Key="AuditStatusToBadgeFg"/>
            <converters:AuditStatusToTextConverter x:Key="AuditStatusToText"/>
            <converters:DataSourceToBadgeBgConverter x:Key="DataSourceToBadgeBg"/>
            <converters:DataSourceToBadgeFgConverter x:Key="DataSourceToBadgeFg"/>
            <converters:DataSourceToTextConverter x:Key="DataSourceToText"/>

            <!-- ========================================================= -->
            <!-- NHN BRAND BLUE COLOR PALETTE                              -->
            <!-- ========================================================= -->
            <!-- Navy chính: #001947 -->
            <SolidColorBrush x:Key="NavyMainBrush" Color="#001947"/>
            <!-- Xanh điện (Primary Action): #0078F9 -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#0078F9"/>
            <SolidColorBrush x:Key="ElectricBlueBrush" Color="#0078F9"/>
            <!-- Xanh nhấn (Hover / Accent): #0061E6 -->
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0061E6"/>
            <!-- Xanh nhấn sâu (Pressed): #001947 -->
            <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#001947"/>
            <!-- Xanh Cyan: #0095FB -->
            <SolidColorBrush x:Key="CyanBlueBrush" Color="#0095FB"/>
            <!-- Nền xanh nhạt -->
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EBF4FF"/>

            <!-- Xanh lá thành công: #15B84A -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#15B84A"/>
            <SolidColorBrush x:Key="SuccessHoverBrush" Color="#129E3F"/>
            <SolidColorBrush x:Key="SuccessLightBrush" Color="#E8F8EE"/>

            <!-- Vàng cảnh báo: #F2A900 -->
            <SolidColorBrush x:Key="WarningBrush" Color="#F2A900"/>
            <SolidColorBrush x:Key="WarningHoverBrush" Color="#DB9700"/>
            <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF6E6"/>

            <!-- Đỏ báo lỗi: #C53D32 -->
            <SolidColorBrush x:Key="DangerBrush" Color="#C53D32"/>
            <SolidColorBrush x:Key="DangerHoverBrush" Color="#AD342B"/>
            <SolidColorBrush x:Key="DangerLightBrush" Color="#FAECEB"/>

            <!-- Nền ứng dụng & Card: Light Mode NHN -->
            <SolidColorBrush x:Key="BgBrush" Color="#F4F7FC"/>
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="BorderLightBrush" Color="#E2E8F0"/>

            <!-- Chữ chính: Siêu sắc nét #0F172A -->
            <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#334155"/>
            <SolidColorBrush x:Key="TextSubtleBrush" Color="#64748B"/>

            <!-- Embedded font keeps the published app consistent across Windows machines. -->
            <FontFamily x:Key="SegoeFont">pack://application:,,,/Assets/#Be Vietnam Pro</FontFamily>

            <!-- Global Crisp Text & Rendering Defaults -->
            <Style TargetType="Window">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            </Style>

            <Style TargetType="UserControl">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <!-- Card Style with Sharp Borders (Anti-blur) -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#001947" Opacity="0.04"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========================================================= -->
            <!-- MODERN BUTTONS (TACTILE MICRO-PRESS & FLUID RENDERING)    -->
            <!-- ========================================================= -->
            <Style x:Key="PrimaryBtn" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource PrimaryPressedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
                                    <Setter TargetName="btnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SuccessHoverBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#0E7A31"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#0E7A31"/>
                                    <Setter TargetName="btnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource DangerHoverBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#8C241D"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#8C241D"/>
                                    <Setter TargetName="btnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource WarningHoverBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource WarningHoverBrush}"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#B57D00"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#B57D00"/>
                                    <Setter TargetName="btnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryBtn" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#F0F7FF"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E0EFFF"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                                    <Setter TargetName="btnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DestructiveBtn" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#DC2626"/>
                <Setter Property="Background" Value="#FEF2F2"/>
                <Setter Property="BorderBrush" Value="#FECACA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FCA5A5"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#FCA5A5"/>
                                    <Setter TargetName="btnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.975" ScaleY="0.975"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ========================================================= -->
            <!-- SEGMENTED IN-PAGE TAB BUTTON STYLE (SUPER FAST & SMOOTH)  -->
            <!-- ========================================================= -->
            <Style x:Key="TabBtn" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="tabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Inactive Hover -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabBorder" Property="Background" Value="#EBF4FF"/>
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <!-- Pressed -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="tabBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <!-- Active State (Tag="Active") -->
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <!-- Active Hover -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Tag" Value="Active"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern TextBox Style -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="txtBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="txtBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="txtBorder" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Flat DataGrid Styles -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderLightBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="RowHeight" Value="42"/>
                <Setter Property="RowBackground" Value="#FFFFFF"/>
                <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            </Style>

            <!-- Modern Column Header -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <!-- Modern Row Style with Hover & Selection -->
            <Style TargetType="DataGridRow">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F0F7FF"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E0EFFF"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Modern Cell Style -->
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Modern CheckBox -->
            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource SegoeFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
