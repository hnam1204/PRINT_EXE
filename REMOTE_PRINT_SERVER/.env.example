RPM_SERVER_ENV=development
DATABASE_URL=sqlite:///./remote_print_server.db
ENROLLMENT_SECRET=replace-with-a-long-random-secret
ADMIN_API_KEY=replace-with-a-separate-long-random-secret
CRON_SECRET=replace-with-a-separate-cron-secret
ALLOWED_ORIGINS=http://localhost:3000
MAX_DOCUMENT_BYTES=4194304
MAX_CLIENTS_PER_HOST=15
GEOFENCE_MAX_ACCURACY_METERS=200
GEOFENCE_MAX_AGE_SECONDS=300
# Set one or both when using Vercel Blob private storage.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
PAIRING_TTL_MINUTES=10
MAX_PAIRING_ATTEMPTS=5
HEARTBEAT_TIMEOUT_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_ATTEMPTS=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
REALTIME_GATEWAY_URL=wss://realtime.example.com/ws
REALTIME_GATEWAY_SHARED_SECRET=replace-with-a-separate-gateway-secret
# Optional gateway-side PostgreSQL connection for LISTEN/NOTIFY wakeups.
# The durable realtime_events table remains the replay source of truth.
REALTIME_DATABASE_CONNECTION_STRING=
REALTIME_EVENT_RETENTION_SECONDS=604800
PAIRING_CODE_RETENTION_SECONDS=259200
TELEGRAM_MESSAGE_RETENTION_SECONDS=2592000
PRINT_JOB_TOMBSTONE_RETENTION_SECONDS=2592000
